<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <XashRtDeployEnabled Condition="'$(XashRtDeployEnabled)' == ''">false</XashRtDeployEnabled>
    <XashRtSdl2SdkPath Condition="'$(XashRtSdl2SdkPath)' == ''">$(MSBuildThisFileDirectory)SDL2_VC</XashRtSdl2SdkPath>
    <RTGL1_SDK_PATH Condition="'$(RTGL1_SDK_PATH)' == ''">$(MSBuildThisFileDirectory)RTGL1</RTGL1_SDK_PATH>
    <XashRtRayTracedGL1Dll Condition="'$(XashRtRayTracedGL1Dll)' == ''">$(RTGL1_SDK_PATH)\Build\x64-$(Configuration)\RayTracedGL1.dll</XashRtRayTracedGL1Dll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(XashRtSdl2Dll)' == '' And '$(Platform)' == 'x64'">
    <XashRtSdl2Dll>$(XashRtSdl2SdkPath)\lib\x64\SDL2.dll</XashRtSdl2Dll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(XashRtSdl2Dll)' == '' And ('$(Platform)' == 'Win32' Or '$(Platform)' == 'x86')">
    <XashRtSdl2Dll>$(XashRtSdl2SdkPath)\lib\x86\SDL2.dll</XashRtSdl2Dll>
  </PropertyGroup>
</Project>
