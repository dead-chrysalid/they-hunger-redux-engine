+++ b/Source/Shaders/EfColorTint.comp
@@ -42,0 +43,13 @@ vec3 applyTint(vec3 color)
+vec3 applyImpactLens(ivec2 pix)
+{
+    vec2 c = effect_getCenteredFromPix(pix);
+    float radiusSquared = dot(c, c);
+    float edgeWeight = smoothstep(0.04, 1.5, radiusSquared);
+    float strength = clamp(push.custom.intensity, 0.0, 0.5) * getProgress();
+
+    // Pull edge samples toward the center. This expands the middle of the
+    // image while progressively bending the perimeter like a short lens hit.
+    vec2 sampleCoord = c * (1.0 - strength * edgeWeight);
+    return effect_loadFromSource_Centered(sampleCoord);
+}
