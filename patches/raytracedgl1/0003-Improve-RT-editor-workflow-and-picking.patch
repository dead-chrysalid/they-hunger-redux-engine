diff --git a/Source/LiveEditorLogic.h b/Source/LiveEditorLogic.h
new file mode 100644
index 0000000..b0fab2d
--- /dev/null
+++ b/Source/LiveEditorLogic.h
@@ -0,0 +1,178 @@
+// Copyright (c) 2026 They Still Hunger contributors
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <RTGL1/RTGL1.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <span>
+
+namespace RTGL1::live_editor_logic
+{
+
+constexpr bool IsShiftScancode( int key )
+{
+    return key == 225 || key == 229;
+}
+
+struct ModeState
+{
+    bool editRequested{ true };
+    bool leftShift{};
+    bool rightShift{};
+
+    bool IsEditing() const { return editRequested && !leftShift && !rightShift; }
+
+    void ResetToEdit()
+    {
+        editRequested = true;
+        leftShift = false;
+        rightShift = false;
+    }
+
+    void Toggle()
+    {
+        editRequested = !editRequested;
+    }
+
+    void SetShift( int key, bool down )
+    {
+        if( key == 225 ) leftShift = down;
+        if( key == 229 ) rightShift = down;
+    }
+};
+
+inline float DefaultEmitterRadius( float oneGameUnitInMeters )
+{
+    return 0.05f / std::max( oneGameUnitInMeters, 0.00001f );
+}
+
+inline float GlyphScale( float cameraDistance )
+{
+    return std::clamp( 128.0f / std::max( cameraDistance, 0.001f ), 1.0f, 3.0f );
+}
+
+inline bool GlyphHitTest( float deltaX, float deltaY, float radius )
+{
+    return deltaX * deltaX + deltaY * deltaY <= radius * radius;
+}
+
+inline float IntegerIntensity( float intensity )
+{
+    return std::trunc( std::max( 0.0f, intensity ) );
+}
+
+template< typename Tab >
+bool ConsumeDeferredTab( Tab& requested, Tab opened, Tab none )
+{
+    if( requested != opened ) return false;
+    requested = none;
+    return true;
+}
+
+inline bool IsPickablePrimitive( uint32_t flags )
+{
+    return ( flags & ( RG_MESH_PRIMITIVE_FIRST_PERSON |
+                       RG_MESH_PRIMITIVE_FIRST_PERSON_VIEWER ) ) == 0;
+}
+
+struct CursorRay
+{
+    RgFloat3D origin{};
+    RgFloat3D direction{ { 0, 0, -1 } };
+};
+
+inline CursorRay MakeCursorRay( const float* inverseView,
+                                float        fovYRadians,
+                                float        width,
+                                float        height,
+                                float        mouseX,
+                                float        mouseY )
+{
+    CursorRay result{};
+    if( !inverseView || width <= 0.0f || height <= 0.0f )
+    {
+        return result;
+    }
+
+    result.origin = { inverseView[ 12 ], inverseView[ 13 ], inverseView[ 14 ] };
+    const RgFloat3D right{ inverseView[ 0 ], inverseView[ 1 ], inverseView[ 2 ] };
+    const RgFloat3D up{ inverseView[ 4 ], inverseView[ 5 ], inverseView[ 6 ] };
+    const RgFloat3D forward{ -inverseView[ 8 ], -inverseView[ 9 ], -inverseView[ 10 ] };
+
+    const float ndcX = mouseX / width * 2.0f - 1.0f;
+    const float ndcY = 1.0f - mouseY / height * 2.0f;
+    const float tanHalfY = std::tan( fovYRadians * 0.5f );
+    const float tanHalfX = tanHalfY * width / height;
+    RgFloat3D direction{
+        forward.data[ 0 ] + right.data[ 0 ] * ndcX * tanHalfX +
+            up.data[ 0 ] * ndcY * tanHalfY,
+        forward.data[ 1 ] + right.data[ 1 ] * ndcX * tanHalfX +
+            up.data[ 1 ] * ndcY * tanHalfY,
+        forward.data[ 2 ] + right.data[ 2 ] * ndcX * tanHalfX +
+            up.data[ 2 ] * ndcY * tanHalfY,
+    };
+    const float length = std::sqrt( direction.data[ 0 ] * direction.data[ 0 ] +
+                                    direction.data[ 1 ] * direction.data[ 1 ] +
+                                    direction.data[ 2 ] * direction.data[ 2 ] );
+    if( length > 0.000001f )
+    {
+        direction.data[ 0 ] /= length;
+        direction.data[ 1 ] /= length;
+        direction.data[ 2 ] /= length;
+    }
+    result.direction = direction;
+    return result;
+}
+
+struct VolumetricCandidate
+{
+    bool  marked{};
+    bool  directional{};
+    float intensity{};
+};
+
+inline std::optional< size_t > SelectVolumetricCandidate(
+    std::span< const VolumetricCandidate > candidates,
+    bool                                   markedOnly,
+    std::optional< size_t >                preferred = std::nullopt )
+{
+    const auto eligible = [ & ]( size_t i ) {
+        return i < candidates.size() && ( !markedOnly || candidates[ i ].marked );
+    };
+    if( preferred && eligible( *preferred ) )
+    {
+        return preferred;
+    }
+
+    const bool hasDirectional = [ & ] {
+        for( size_t i = 0; i < candidates.size(); i++ )
+        {
+            if( eligible( i ) && candidates[ i ].directional ) return true;
+        }
+        return false;
+    }();
+
+    std::optional< size_t > best;
+    float bestIntensity = -std::numeric_limits< float >::infinity();
+    for( size_t i = 0; i < candidates.size(); i++ )
+    {
+        if( !eligible( i ) || ( hasDirectional && !candidates[ i ].directional ) )
+        {
+            continue;
+        }
+        if( !best || candidates[ i ].intensity > bestIntensity )
+        {
+            best = i;
+            bestIntensity = candidates[ i ].intensity;
+        }
+    }
+    return best;
+}
+
+} // namespace RTGL1::live_editor_logic
