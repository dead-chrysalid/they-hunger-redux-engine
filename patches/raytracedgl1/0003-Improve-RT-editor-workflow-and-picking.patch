+float Distance( const RgFloat3D& a, const RgFloat3D& b )
+{
+    const float x = a.data[ 0 ] - b.data[ 0 ];
+    const float y = a.data[ 1 ] - b.data[ 1 ];
+    const float z = a.data[ 2 ] - b.data[ 2 ];
+    return std::sqrt( x * x + y * y + z * z );
+}
+
+struct ProjectedLightGlyph
+{
+    ImVec2 screen{};
+    float cameraDistance{};
+    float scale{ 1.0f };
+    float hitRadius{ 10.0f };
+    bool directional{};
+};
+
+bool ProjectLightGlyph( const RgDrawFrameInfo& drawInfo,
+                        const ImVec2& displaySize,
+                        const RgFloat3D& camera,
+                        const RTGL1::GenericLight& light,
+                        const RgFloat3D& nodePosition,
+                        ProjectedLightGlyph& result )
+{
+    result.directional = std::holds_alternative< RgDirectionalLightUploadInfo >( light );
+    RgFloat3D point = LightPosition( light, nodePosition );
+    if( result.directional )
+    {
+        const RgFloat3D direction = LightDirection( light );
+        point = { camera.data[ 0 ] - direction.data[ 0 ] * 128.0f,
+                  camera.data[ 1 ] - direction.data[ 1 ] * 128.0f,
+                  camera.data[ 2 ] - direction.data[ 2 ] * 128.0f };
+    }
+    if( !Project( drawInfo.view,
+                  drawInfo.fovYRadians,
+                  displaySize.x,
+                  displaySize.y,
+                  point,
+                  result.screen ) )
+    {
+        return false;
+    }
+    result.cameraDistance = Distance( point, camera );
+    result.scale = RTGL1::live_editor_logic::GlyphScale( result.cameraDistance );
+    result.hitRadius = ( result.directional ? 14.0f : 10.0f ) * result.scale;
+    return true;
+}
+
+void DrawSunGlyph( ImDrawList* draw,
+                   const ImVec2& center,
+                   float scale,
+                   ImU32 lightColor,
+                   bool selected )
+{
+    constexpr float TWO_PI = 6.28318530718f;
+    const ImU32 black = IM_COL32( 0, 0, 0, 255 );
+    draw->AddCircleFilled( center, 5.0f * scale, lightColor, 20 );
+    draw->AddCircle( center, 7.0f * scale, black, 20, 2.0f );
+    for( int i = 0; i < 8; i++ )
+    {
+        const float angle = TWO_PI * static_cast< float >( i ) / 8.0f;
+        const ImVec2 inner{ center.x + std::cos( angle ) * 8.5f * scale,
+                           center.y + std::sin( angle ) * 8.5f * scale };
+        const ImVec2 outer{ center.x + std::cos( angle ) * 13.0f * scale,
+                           center.y + std::sin( angle ) * 13.0f * scale };
+        draw->AddLine( inner, outer, black, 3.5f );
+        draw->AddLine( inner, outer, lightColor, 1.5f );
+    }
+    if( selected )
+    {
+        draw->AddCircle( center, 15.5f * scale, IM_COL32( 255, 255, 255, 255 ), 24, 2.0f );
+    }
+}
+
+void DrawProjectedRing( ImDrawList* draw,
+                        const RgDrawFrameInfo& drawInfo,
+                        const ImVec2& displaySize,
+                        const RgFloat3D& center,
+                        const RgFloat3D& axisA,
+                        const RgFloat3D& axisB,
+                        float radius,
+                        ImU32 color,
+                        float thickness )
+{
+    constexpr size_t SEGMENT_COUNT = 32;
+    constexpr float TWO_PI = 6.28318530718f;
+    std::array< ImVec2, SEGMENT_COUNT > ring{};
+    std::array< bool, SEGMENT_COUNT > visible{};
+    for( size_t i = 0; i < SEGMENT_COUNT; i++ )
+    {
+        const float radians = TWO_PI * static_cast< float >( i ) /
+                              static_cast< float >( SEGMENT_COUNT );
+        const float x = std::cos( radians ) * radius;
+        const float y = std::sin( radians ) * radius;
+        const RgFloat3D point{ center.data[ 0 ] + axisA.data[ 0 ] * x + axisB.data[ 0 ] * y,
+                              center.data[ 1 ] + axisA.data[ 1 ] * x + axisB.data[ 1 ] * y,
+                              center.data[ 2 ] + axisA.data[ 2 ] * x + axisB.data[ 2 ] * y };
+        visible[ i ] = Project( drawInfo.view,
+                                drawInfo.fovYRadians,
+                                displaySize.x,
+                                displaySize.y,
+                                point,
+                                ring[ i ] );
+    }
+    for( size_t i = 0; i < SEGMENT_COUNT; i++ )
+    {
+        const size_t next = ( i + 1 ) % SEGMENT_COUNT;
+        if( visible[ i ] && visible[ next ] )
+        {
+            draw->AddLine( ring[ i ], ring[ next ], color, thickness );
+        }
+    }
+}
