+void RTGL1::LiveEditor::DuplicateSelectedLight( Scene& scene )
+{
+    if( selectedLight < 0 || selectedLight >= static_cast< int >( lights.size() ) ) return;
+    const std::string previousVolumetric = DescribeVolumetricSource();
+    BeginLightAction();
+    EditableLight copy = lights[ selectedLight ];
+    const bool transferVolumetric = LightExtra( copy.value ).isVolumetric != 0;
+    const uint64_t id = NewLightId();
+    copy.id = std::to_string( id );
+    copy.name += " copy";
+    std::visit( [ id ]( auto& value ) { value.uniqueID = id; }, copy.value );
+    lights.push_back( std::move( copy ) );
+    selectedLight = static_cast< int >( lights.size() ) - 1;
+    NormalizeVolumetric( transferVolumetric
+                             ? std::optional< size_t >( static_cast< size_t >( selectedLight ) )
+                             : std::nullopt );
+    EndLightAction( true, scene );
+    ShowVolumetricChange( previousVolumetric );
+}
+
+void RTGL1::LiveEditor::DeleteSelectedLight( Scene& scene )
+{
+    if( selectedLight < 0 || selectedLight >= static_cast< int >( lights.size() ) ) return;
+    const std::string previousVolumetric = DescribeVolumetricSource();
+    BeginLightAction();
+    lights.erase( lights.begin() + selectedLight );
+    selectedLight = std::min( selectedLight, static_cast< int >( lights.size() ) - 1 );
+    NormalizeVolumetric();
+    EndLightAction( true, scene );
+    ShowVolumetricChange( previousVolumetric );
+}
+
+void RTGL1::LiveEditor::PasteSelectedLight( Scene& scene )
+{
+    if( !lightClipboard || selectedLight < 0 ||
+        selectedLight >= static_cast< int >( lights.size() ) )
+    {
+        return;
+    }
+
+    const std::string previousVolumetric = DescribeVolumetricSource();
+    BeginLightAction();
+    EditableLight& target = lights[ selectedLight ];
+    const uint64_t targetId = LightId( target.value );
+    const RgFloat3D targetPosition = LightPosition( target.value, target.nodePosition );
+    const RgFloat3D targetNodePosition = target.nodePosition;
+
+    EditableLight replacement = *lightClipboard;
+    replacement.id = target.id;
+    replacement.nodePosition = targetNodePosition;
+    std::visit( [ targetId ]( auto& value ) { value.uniqueID = targetId; }, replacement.value );
+    if( auto* point = std::get_if< RgSphericalLightUploadInfo >( &replacement.value ) )
+        point->position = targetPosition;
+    if( auto* spot = std::get_if< RgSpotLightUploadInfo >( &replacement.value ) )
+        spot->position = targetPosition;
+
+    const bool transferVolumetric = LightExtra( replacement.value ).isVolumetric != 0;
+    target = std::move( replacement );
+    NormalizeVolumetric( transferVolumetric
+                             ? std::optional< size_t >( static_cast< size_t >( selectedLight ) )
+                             : std::nullopt );
+    EndLightAction( true, scene );
+    ShowVolumetricChange( previousVolumetric );
+}
+
+void RTGL1::LiveEditor::UndoAtmosphere( SceneMetaManager& manager, bool redo )
+{
+    if( !scenesDocument ) return;
+    std::string error;
+    const bool changed = redo ? scenesDocument->Redo( ValidateScenes, error )
+                              : scenesDocument->Undo( ValidateScenes, error );
+    if( changed )
+    {
+        manager.ClearLiveOverrides();
+        manager.OnFileChanged( FileType::JSON, manager.GetPath() );
+        sceneEdit = manager.Access( currentMap ).value_or( SceneMeta{} );
+        sceneEdit.sceneName = currentMap;
+        manager.SetLiveOverride( currentMap, sceneEdit );
+        statusMessage = redo ? "Redid atmosphere action and saved"
+                             : "Undid atmosphere action and saved";
+    }
+    else if( !error.empty() )
+    {
+        statusMessage = error;
+    }
+}
+
+void RTGL1::LiveEditor::UndoTexture( TextureMetaManager& manager,
+                                     SceneImportExport& sceneImportExport,
+                                     bool redo )
+{
+    LiveEditorDocument* document =
+        texturePerScene ? sceneTexturesDocument.get() : globalTexturesDocument.get();
+    if( !document ) return;
+    std::string error;
+    const bool changed = redo ? document->Redo( ValidateTextures, error )
+                              : document->Undo( ValidateTextures, error );
+    if( changed )
+    {
+        manager.ClearLiveOverrides();
+        manager.RereadFromFiles( std::string_view( currentMap ) );
+        if( !selectedTexture.empty() )
+        {
+            textureEdit = manager.AccessConfig( selectedTexture, texturePerScene )
+                              .value_or( TextureMetaConfig{} );
+            textureEdit.textureName = selectedTexture;
+            textureEditPerScene = texturePerScene;
+        }
+        sceneImportExport.RequestReimport();
+        statusMessage = redo ? "Redid texture action and saved"
+                             : "Undid texture action and saved";
+    }
+    else if( !error.empty() )
+    {
+        statusMessage = error;
+    }
+}
