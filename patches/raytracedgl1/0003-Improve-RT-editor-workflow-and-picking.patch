+std::string RTGL1::LiveEditor::DescribeVolumetricSource() const
+{
+    const EditableLight* marked = nullptr;
+    for( const EditableLight& light : lights )
+    {
+        if( LightExtra( light.value ).isVolumetric )
+        {
+            if( marked ) return "multiple marked lights";
+            marked = &light;
+        }
+    }
+    return marked ? marked->name : "none";
+}
+
+bool RTGL1::LiveEditor::NormalizeVolumetric( std::optional< size_t > preferred )
+{
+    if( lights.empty() ) return false;
+
+    std::vector< live_editor_logic::VolumetricCandidate > candidates;
+    candidates.reserve( lights.size() );
+    size_t markedCount = 0;
+    for( const EditableLight& light : lights )
+    {
+        const bool marked = LightExtra( light.value ).isVolumetric != 0;
+        markedCount += marked ? 1 : 0;
+        candidates.push_back( {
+            .marked = marked,
+            .directional = std::holds_alternative< RgDirectionalLightUploadInfo >( light.value ),
+            .intensity = LightIntensity( light.value ),
+        } );
+    }
+
+    std::optional< size_t > chosen;
+    if( markedCount == 1 )
+    {
+        chosen = live_editor_logic::SelectVolumetricCandidate( candidates, true, preferred );
+    }
+    else if( markedCount > 1 )
+    {
+        chosen = live_editor_logic::SelectVolumetricCandidate( candidates, true, preferred );
+    }
+    else
+    {
+        chosen = live_editor_logic::SelectVolumetricCandidate( candidates, false, preferred );
+    }
+
+    bool changed = false;
+    for( size_t i = 0; i < lights.size(); i++ )
+    {
+        RgLightExtraInfo& extra = LightExtra( lights[ i ].value );
+        extra.exists = true;
+        const bool shouldBeMarked = chosen && i == *chosen;
+        if( ( extra.isVolumetric != 0 ) != shouldBeMarked )
+        {
+            extra.isVolumetric = shouldBeMarked;
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+void RTGL1::LiveEditor::ShowVolumetricChange( std::string_view previous )
+{
+    const std::string current = DescribeVolumetricSource();
+    if( previous == current ) return;
+    statusMessage = "Volumetric source changed: " + std::string( previous ) + " -> " + current;
+    if( gltfDocument && gltfDocument->IsDirty() )
+        statusMessage += " (unsaved)";
+    else
+        statusMessage += " (saved)";
+}
+
+void RTGL1::LiveEditor::NormalizeVolumetricAfterLoad( Scene& scene )
+{
+    normalizeVolumetricOnNextFrame = false;
+    const std::string previous = DescribeVolumetricSource();
+    if( !NormalizeVolumetric() ) return;
+
+    ApplyLights( scene );
+    if( gltfDocument ) gltfDocument->BeginAction();
+    if( SaveLights() ) needsGltfMirror = false;
+    ShowVolumetricChange( previous );
+}
