+void RTGL1::LiveEditor::HandleHotkeys( Scene& scene,
+                                       SceneImportExport& sceneImportExport,
+                                       SceneMetaManager& sceneMeta,
+                                       TextureMetaManager& textureMeta )
+{
+    ImGuiIO& io = ImGui::GetIO();
+    const bool popupOpen = ImGui::IsPopupOpen( nullptr, ImGuiPopupFlags_AnyPopup );
+
+    if( ImGui::IsKeyPressed( ImGuiKey_Escape, false ) && !popupOpen &&
+        !ImGui::IsAnyItemActive() )
+    {
+        selectedLight = -1;
+        selectedSurface = {};
+        requestedTab = WorkspaceTab::None;
+        statusMessage = "Selection cleared";
+    }
+
+    if( io.WantTextInput || ImGui::IsAnyItemActive() || popupOpen || ImGuizmo::IsUsing() )
+    {
+        return;
+    }
+
+    const bool control = io.KeyCtrl;
+    if( !control && ImGui::IsKeyPressed( ImGuiKey_R, false ) && selectedLight >= 0 )
+    {
+        rotateGizmo = !rotateGizmo;
+        statusMessage = rotateGizmo ? "Rotate gizmo" : "Move gizmo";
+    }
+    if( !control && ImGui::IsKeyPressed( ImGuiKey_Delete, false ) )
+    {
+        DeleteSelectedLight( scene );
+    }
+    if( control && ImGui::IsKeyPressed( ImGuiKey_C, false ) && selectedLight >= 0 &&
+        selectedLight < static_cast< int >( lights.size() ) )
+    {
+        lightClipboard = lights[ selectedLight ];
+        statusMessage = "Copied light: " + lights[ selectedLight ].name;
+    }
+    if( control && ImGui::IsKeyPressed( ImGuiKey_V, false ) )
+    {
+        PasteSelectedLight( scene );
+    }
+    if( control && ImGui::IsKeyPressed( ImGuiKey_D, false ) )
+    {
+        DuplicateSelectedLight( scene );
+    }
+    if( control && ImGui::IsKeyPressed( ImGuiKey_Z, false ) )
+    {
+        if( activeTab == WorkspaceTab::Lights ) UndoLights( scene );
+        if( activeTab == WorkspaceTab::Atmosphere ) UndoAtmosphere( sceneMeta, false );
+        if( activeTab == WorkspaceTab::Textures )
+            UndoTexture( textureMeta, sceneImportExport, false );
+    }
+    if( control && ImGui::IsKeyPressed( ImGuiKey_Y, false ) )
+    {
+        if( activeTab == WorkspaceTab::Lights ) RedoLights( scene );
+        if( activeTab == WorkspaceTab::Atmosphere ) UndoAtmosphere( sceneMeta, true );
+        if( activeTab == WorkspaceTab::Textures )
+            UndoTexture( textureMeta, sceneImportExport, true );
+    }
+}
