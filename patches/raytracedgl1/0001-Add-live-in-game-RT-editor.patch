+void RTGL1::LiveEditor::EnsureFontTexture( uint32_t frameIndex,
+                                           VkCommandBuffer materialCmd,
+                                           TextureManager& textures )
+{
+    if( fontUploaded ) return;
+    ImGuiIO& io = ImGui::GetIO();
+    unsigned char* pixels{};
+    int width{}, height{};
+    io.Fonts->GetTexDataAsRGBA32( &pixels, &width, &height );
+    const RgOriginalTextureInfo info = {
+        .pTextureName = EDITOR_FONT_TEXTURE,
+        .pPixels = pixels,
+        .size = { uint32_t( width ), uint32_t( height ) },
+        .filter = RG_SAMPLER_FILTER_LINEAR,
+        .addressModeU = RG_SAMPLER_ADDRESS_MODE_CLAMP,
+        .addressModeV = RG_SAMPLER_ADDRESS_MODE_CLAMP,
+    };
+    fontUploaded = textures.TryCreateMaterial( materialCmd, frameIndex, info, overrideFolder );
+}
+
+void RTGL1::LiveEditor::RenderImGui( uint32_t frameIndex,
+                                     VkCommandBuffer materialCmd,
+                                     TextureManager& textures,
+                                     Rasterizer& rasterizer )
+{
+    EnsureFontTexture( frameIndex, materialCmd, textures );
+    if( !fontUploaded ) return;
+    ImDrawData* data = ImGui::GetDrawData();
+    if( !data || data->DisplaySize.x <= 0 || data->DisplaySize.y <= 0 ) return;
+
+    const float projection[ 16 ] = {
+        2.0f / data->DisplaySize.x, 0, 0, 0,
+        0, 2.0f / data->DisplaySize.y, 0, 0,
+        0, 0, -1, 0,
+        -1, -1, 0, 1,
+    };
+    const RgViewport viewport = { 0, 0, data->DisplaySize.x, data->DisplaySize.y, 0, 1 };
+
+    uint32_t primitiveIndex = 0;
+    for( int listIndex = 0; listIndex < data->CmdListsCount; listIndex++ )
+    {
+        const ImDrawList* list = data->CmdLists[ listIndex ];
+        std::vector< RgPrimitiveVertex > vertices( list->VtxBuffer.Size );
+        for( int i = 0; i < list->VtxBuffer.Size; i++ )
+        {
+            const ImDrawVert& src = list->VtxBuffer[ i ];
+            vertices[ i ].position[ 0 ] = src.pos.x;
+            vertices[ i ].position[ 1 ] = src.pos.y;
+            vertices[ i ].position[ 2 ] = 0;
+            vertices[ i ].normal[ 2 ] = 1;
+            vertices[ i ].texCoord[ 0 ] = src.uv.x;
+            vertices[ i ].texCoord[ 1 ] = src.uv.y;
+            vertices[ i ].color = src.col;
+        }
+        for( const ImDrawCmd& command : list->CmdBuffer )
+        {
+            if( command.UserCallback || command.ElemCount == 0 ) continue;
+            const char* drawTexture = command.TextureId
+                                          ? reinterpret_cast< const char* >( command.TextureId )
+                                          : EDITOR_FONT_TEXTURE;
+            std::vector< uint32_t > indices;
+            indices.reserve( command.ElemCount );
+            for( unsigned int i = 0; i < command.ElemCount; i++ )
+            {
+                indices.push_back( uint32_t( list->IdxBuffer[ command.IdxOffset + i ] ) +
+                                   command.VtxOffset );
+            }
+            const RgMeshPrimitiveInfo primitive = {
+                .pPrimitiveNameInMesh = "RT editor UI",
+                .primitiveIndexInMesh = primitiveIndex++,
+                .flags = RG_MESH_PRIMITIVE_TRANSLUCENT,
+                .pVertices = vertices.data(),
+                .vertexCount = uint32_t( vertices.size() ),
+                .pIndices = indices.data(),
+                .indexCount = uint32_t( indices.size() ),
+                .pTextureName = drawTexture,
+                .color = 0xFFFFFFFF,
+                .emissive = 0,
+            };
+            rasterizer.Upload( frameIndex,
+                               GeometryRasterType::SWAPCHAIN,
+                               RG_TRANSFORM_IDENTITY,
+                               primitive,
+                               projection,
+                               &viewport );
+        }
+    }
+}
