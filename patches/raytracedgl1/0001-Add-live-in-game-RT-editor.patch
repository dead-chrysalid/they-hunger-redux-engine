+            .rt_editor_lights = std::move( root.rt_editor_lights ),
+        };
+    }
+    catch( const std::exception& e )
+    {
+        debug::Warning( "Editor glTF metadata read failed for {}: {}", path.string(), e.what() );
+        return std::nullopt;
+    }
