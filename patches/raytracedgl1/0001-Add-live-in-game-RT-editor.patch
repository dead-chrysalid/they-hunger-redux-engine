+namespace RTGL1
+{
+
+// Small JSONC-aware editing layer used by the live editor. It only rewrites the
+// token range belonging to an edited property, so comments, ordering, unknown
+// fields and the rest of a glTF document remain byte-for-byte unchanged.
+class LiveEditorDocument
+{
+public:
+    using Validator = std::function< bool( const std::filesystem::path&, std::string& ) >;
+
+    LiveEditorDocument() = default;
+    LiveEditorDocument( std::filesystem::path path, std::filesystem::path backupRoot );
+
+    bool Load( std::string& error );
+    bool ReloadIfClean( std::string& error, bool* reloaded = nullptr );
+    bool DiscardAndReload( std::string& error );
+
+    void BeginAction();
+    bool EndActionAndSave( const Validator& validator, std::string& error );
+    void CancelAction();
+
+    bool Undo( const Validator& validator, std::string& error );
+    bool Redo( const Validator& validator, std::string& error );
+    bool RetrySave( const Validator& validator, std::string& error );
+
+    bool SetArrayObjectField( std::string_view arrayField,
+                              std::string_view keyField,
+                              std::string_view key,
+                              std::string_view field,
+                              std::optional< std::string_view > jsonValue,
+                              std::string& error );
+
+    bool SetRootField( std::string_view field,
+                       std::optional< std::string_view > jsonValue,
+                       std::string& error );
+    bool SetRootObjectField( std::string_view objectField,
+                             std::string_view field,
+                             std::optional< std::string_view > jsonValue,
+                             std::string& error );
+
+    const std::filesystem::path& Path() const { return path; }
+    const std::string& Text() const { return text; }
+    bool IsDirty() const { return dirty; }
+    bool IsInAction() const { return inAction; }
+    bool HasExternalConflict() const { return externalConflict; }
+    bool CanUndo() const { return !undo.empty(); }
+    bool CanRedo() const { return !redo.empty(); }
+    const std::string& LastError() const { return lastError; }
+
+    static std::string Quote( std::string_view value );
+
+private:
+    bool Save( const Validator& validator, std::string& error );
+    bool CheckExternalChange();
+    bool MakeBackup( std::string& error );
+
+private:
+    std::filesystem::path path;
+    std::filesystem::path backupRoot;
+    std::string           text;
+    std::string           actionStart;
+    std::string           lastError;
+
+    std::vector< std::string > undo;
+    std::vector< std::string > redo;
+
+    std::filesystem::file_time_type diskWriteTime{};
+    uintmax_t diskSize{};
+    bool hasDiskWriteTime{ false };
+    bool diskExisted{ false };
+    bool backupMade{ false };
+    bool dirty{ false };
+    bool inAction{ false };
+    bool actionStartedDirty{ false };
+    bool externalConflict{ false };
+};
+
