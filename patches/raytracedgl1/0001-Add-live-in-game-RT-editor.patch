+bool RTGL1::LiveEditor::SaveSceneField( std::string_view field,
+                                        std::optional< std::string_view > value )
+{
+    if( !scenesDocument ) return false;
+    if( !scenesDocument->IsInAction() ) scenesDocument->BeginAction();
+    std::string error;
+    if( !scenesDocument->SetArrayObjectField(
+            "array", "sceneName", currentMap, field, value, error ) ||
+        !scenesDocument->EndActionAndSave( ValidateScenes, error ) )
+    {
+        statusMessage = error;
+        hasUnsavedChanges = true;
+        return false;
+    }
+    statusMessage = "Saved atmosphere action";
+    return true;
+}
+
+void RTGL1::LiveEditor::DrawAtmospherePanel( SceneMetaManager& manager )
+{
+    auto reloadEditorValue = [ & ] {
+        manager.ClearLiveOverrides();
+        manager.OnFileChanged( FileType::JSON, manager.GetPath() );
+        sceneEdit = manager.Access( currentMap ).value_or( SceneMeta{} );
+        sceneEdit.sceneName = currentMap;
+        manager.SetLiveOverride( currentMap, sceneEdit );
+    };
+    if( scenesDocument )
+    {
+        std::string error;
+        ImGui::BeginDisabled( !scenesDocument->CanUndo() );
+        if( ImGui::Button( "Undo atmosphere" ) )
+        {
+            if( scenesDocument->Undo( ValidateScenes, error ) )
+            {
+                reloadEditorValue();
+                statusMessage = "Undid atmosphere action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !scenesDocument->CanRedo() );
+        if( ImGui::Button( "Redo atmosphere" ) )
+        {
+            if( scenesDocument->Redo( ValidateScenes, error ) )
+            {
+                reloadEditorValue();
+                statusMessage = "Redid atmosphere action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+    }
+
+    auto optionalFloat = [ & ]( const char* label,
+                                const char* field,
+                                std::optional< float >& value,
+                                float defaultValue,
+                                float minimum,
+                                float maximum ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional< float >( defaultValue ) : std::nullopt;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            const std::string json = value ? JsonFloat( *value ) : std::string{};
+            SaveSceneField( field, value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        float edit = value.value_or( defaultValue );
+        if( ImGui::DragFloat( label, &edit, ( maximum - minimum ) / 500.0f, minimum, maximum ) )
+        {
+            if( ImGui::IsItemActivated() && scenesDocument ) scenesDocument->BeginAction();
+            value = std::clamp( edit, minimum, maximum );
+            manager.SetLiveOverride( currentMap, sceneEdit );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() && value )
+        {
+            const std::string json = JsonFloat( *value );
+            SaveSceneField( field, json );
+        }
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+    auto optionalColor = [ & ]( const char* label,
+                                const char* field,
+                                std::optional< std::array< float, 3 > >& value ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional( std::array< float, 3 >{ 1, 1, 1 } ) : std::nullopt;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            const std::string json = value ? JsonArray( *value ) : std::string{};
+            SaveSceneField( field, value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        std::array< float, 3 > edit = value.value_or( std::array< float, 3 >{ 1, 1, 1 } );
+        if( ImGui::ColorEdit3( label, edit.data(), ImGuiColorEditFlags_Float ) )
+        {
+            if( ImGui::IsItemActivated() && scenesDocument ) scenesDocument->BeginAction();
+            for( float& c : edit ) c = std::clamp( c, 0.0f, 1.0f );
+            value = edit;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() && value )
+        {
+            const std::string json = JsonArray( *value );
+            SaveSceneField( field, json );
+        }
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+
+    ImGui::TextWrapped( "Unused values fall back to renderer defaults." );
+    optionalFloat( "Sky multiplier", "sky", sceneEdit.sky, 1.0f, 0.0f, 100.0f );
+    optionalColor( "Forced sky color", "forceSkyPlainColor", sceneEdit.forceSkyPlainColor );
+    optionalFloat( "Scattering", "scatter", sceneEdit.scatter, 0.0f, 0.0f, 100.0f );
+    optionalFloat( "Volumetric distance", "volumeFar", sceneEdit.volumeFar, 1000.0f, 0.001f, 1000000.0f );
+    optionalFloat( "Asymmetry", "volumeAssymetry", sceneEdit.volumeAssymetry, 0.0f, 0.0f, 1.0f );
+    optionalFloat( "Light multiplier", "volumeLightMultiplier", sceneEdit.volumeLightMultiplier, 1.0f, 0.0f, 1000.0f );
+    optionalColor( "Ambient color", "volumeAmbient", sceneEdit.volumeAmbient );
+    optionalColor( "Underwater tint", "volumeUnderwaterColor", sceneEdit.volumeUnderwaterColor );
+}
