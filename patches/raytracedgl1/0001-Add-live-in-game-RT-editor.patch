+
+bool RayTriangle( const RgFloat3D& origin,
+                  const RgFloat3D& direction,
+                  const RgFloat3D& a,
+                  const RgFloat3D& b,
+                  const RgFloat3D& c,
+                  float& distance )
+{
+    auto sub = []( const RgFloat3D& x, const RgFloat3D& y ) {
+        return RgFloat3D{ x.data[ 0 ] - y.data[ 0 ],
+                          x.data[ 1 ] - y.data[ 1 ],
+                          x.data[ 2 ] - y.data[ 2 ] };
+    };
+    auto cross = []( const RgFloat3D& x, const RgFloat3D& y ) {
+        return RgFloat3D{ x.data[ 1 ] * y.data[ 2 ] - x.data[ 2 ] * y.data[ 1 ],
+                          x.data[ 2 ] * y.data[ 0 ] - x.data[ 0 ] * y.data[ 2 ],
+                          x.data[ 0 ] * y.data[ 1 ] - x.data[ 1 ] * y.data[ 0 ] };
+    };
+    auto dot = []( const RgFloat3D& x, const RgFloat3D& y ) {
+        return x.data[ 0 ] * y.data[ 0 ] + x.data[ 1 ] * y.data[ 1 ] +
+               x.data[ 2 ] * y.data[ 2 ];
+    };
+    const RgFloat3D edge1 = sub( b, a );
+    const RgFloat3D edge2 = sub( c, a );
+    const RgFloat3D h = cross( direction, edge2 );
+    const float determinant = dot( edge1, h );
+    if( std::abs( determinant ) < 0.000001f )
+    {
+        return false;
+    }
+    const float inverse = 1.0f / determinant;
+    const RgFloat3D s = sub( origin, a );
+    const float u = inverse * dot( s, h );
+    if( u < 0.0f || u > 1.0f )
+    {
+        return false;
+    }
+    const RgFloat3D q = cross( s, edge1 );
+    const float v = inverse * dot( direction, q );
+    if( v < 0.0f || u + v > 1.0f )
+    {
+        return false;
+    }
+    distance = inverse * dot( edge2, q );
+    return distance > 0.001f;
+}
+
+bool Project( const float* view,
+              float fov,
+              float width,
+              float height,
+              const RgFloat3D& point,
+              ImVec2& result )
+{
+    float projection[ 16 ];
+    RTGL1::Matrix::MakeProjectionMatrix( projection, width / height, fov, 0.01f, 100000.0f );
+    // RTGL's Vulkan projection has a negative Y scale. ImGui and ImGuizmo
+    // perform their own clip-to-screen Y flip, so undo the Vulkan flip here.
+    projection[ 1 * 4 + 1 ] = -projection[ 1 * 4 + 1 ];
+    auto mul = []( const float* m, const float* v, float* out ) {
+        for( int row = 0; row < 4; row++ )
+        {
+            out[ row ] = m[ 0 * 4 + row ] * v[ 0 ] + m[ 1 * 4 + row ] * v[ 1 ] +
+                         m[ 2 * 4 + row ] * v[ 2 ] + m[ 3 * 4 + row ] * v[ 3 ];
+        }
+    };
+    float world[ 4 ]{ point.data[ 0 ], point.data[ 1 ], point.data[ 2 ], 1.0f };
+    float camera[ 4 ], clip[ 4 ];
+    mul( view, world, camera );
+    mul( projection, camera, clip );
+    if( clip[ 3 ] <= 0.0001f )
+    {
+        return false;
+    }
+    result.x = ( clip[ 0 ] / clip[ 3 ] * 0.5f + 0.5f ) * width;
+    result.y = ( -clip[ 1 ] / clip[ 3 ] * 0.5f + 0.5f ) * height;
+    return true;
+}
+
+RgFloat3D Cross( const RgFloat3D& a, const RgFloat3D& b )
+{
+    return { a.data[ 1 ] * b.data[ 2 ] - a.data[ 2 ] * b.data[ 1 ],
+             a.data[ 2 ] * b.data[ 0 ] - a.data[ 0 ] * b.data[ 2 ],
+             a.data[ 0 ] * b.data[ 1 ] - a.data[ 1 ] * b.data[ 0 ] };
+}
+
+void DrawProjectedSpotCone( ImDrawList* draw,
+                            const RgDrawFrameInfo& drawInfo,
+                            const ImVec2& displaySize,
+                            const RgSpotLightUploadInfo& spot,
+                            float angle,
+                            float length,
+                            ImU32 color,
+                            bool drawSpokes,
+                            float thickness )
+{
+    constexpr size_t SEGMENT_COUNT = 24;
+    constexpr float TWO_PI = 6.28318530718f;
+
+    const RgFloat3D direction =
+        RTGL1::Utils::SafeNormalize( spot.direction, { 0, 0, -1 } );
+    const RgFloat3D reference =
+        std::abs( direction.data[ 2 ] ) < 0.95f ? RgFloat3D{ 0, 0, 1 }
+                                                : RgFloat3D{ 0, 1, 0 };
+    const RgFloat3D right = RTGL1::Utils::SafeNormalize( Cross( direction, reference ),
+                                                         { 1, 0, 0 } );
+    const RgFloat3D up = RTGL1::Utils::SafeNormalize( Cross( right, direction ), { 0, 1, 0 } );
+
+    const float safeAngle = std::max( 0.0f, std::min( angle, 1.55334306f ) );
+    const float radius = std::tan( safeAngle ) * length;
+    const RgFloat3D center{ spot.position.data[ 0 ] + direction.data[ 0 ] * length,
+                           spot.position.data[ 1 ] + direction.data[ 1 ] * length,
+                           spot.position.data[ 2 ] + direction.data[ 2 ] * length };
+
+    ImVec2 apex{};
+    const bool apexVisible = Project( drawInfo.view,
+                                      drawInfo.fovYRadians,
+                                      displaySize.x,
+                                      displaySize.y,
+                                      spot.position,
+                                      apex );
+    std::array< ImVec2, SEGMENT_COUNT > ring{};
+    std::array< bool, SEGMENT_COUNT > visible{};
+    for( size_t i = 0; i < SEGMENT_COUNT; i++ )
+    {
+        const float radians = TWO_PI * static_cast< float >( i ) /
+                              static_cast< float >( SEGMENT_COUNT );
+        const float x = std::cos( radians ) * radius;
+        const float y = std::sin( radians ) * radius;
+        const RgFloat3D point{ center.data[ 0 ] + right.data[ 0 ] * x + up.data[ 0 ] * y,
+                              center.data[ 1 ] + right.data[ 1 ] * x + up.data[ 1 ] * y,
+                              center.data[ 2 ] + right.data[ 2 ] * x + up.data[ 2 ] * y };
+        visible[ i ] = Project( drawInfo.view,
+                                drawInfo.fovYRadians,
+                                displaySize.x,
+                                displaySize.y,
+                                point,
+                                ring[ i ] );
+    }
+
+    for( size_t i = 0; i < SEGMENT_COUNT; i++ )
+    {
+        const size_t next = ( i + 1 ) % SEGMENT_COUNT;
+        if( visible[ i ] && visible[ next ] )
+        {
+            draw->AddLine( ring[ i ], ring[ next ], color, thickness );
+        }
+        if( drawSpokes && apexVisible && visible[ i ] && i % 6 == 0 )
+        {
+            draw->AddLine( apex, ring[ i ], color, thickness );
+        }
+    }
+}
+} // namespace
+
+RTGL1::LiveEditor::LiveEditor( std::filesystem::path _overrideFolder )
+    : overrideFolder( std::move( _overrideFolder ) )
+    , backupFolder( overrideFolder / "editor-backups" /
+                    ( "session-" + std::to_string(
+                        std::chrono::duration_cast< std::chrono::milliseconds >(
+                            std::chrono::system_clock::now().time_since_epoch() ).count() ) ) )
+{
+#ifdef RG_USE_IMGUI
+    ImGuiContextScope scope( nullptr );
+    imguiContext = ImGui::CreateContext();
+    ImGui::SetCurrentContext( imguiContext );
+    ImGuiIO& io = ImGui::GetIO();
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+    io.BackendPlatformName = "xash-rt-live-editor";
+    // This context has no ImGui platform/renderer backend to build the atlas
+    // during its NewFrame call. Build it eagerly; EnsureFontTexture uploads the
+    // resulting pixels through RTGL on the first rendered editor frame.
+    unsigned char* fontPixels{};
+    int fontWidth{}, fontHeight{};
+    io.Fonts->GetTexDataAsRGBA32( &fontPixels, &fontWidth, &fontHeight );
+    ImGui::StyleColorsDark();
+#endif
+}
+
+RTGL1::LiveEditor::~LiveEditor()
+{
+#ifdef RG_USE_IMGUI
+    if( imguiContext )
+    {
+        ImGuiContextScope scope( imguiContext );
+        ImGui::DestroyContext( imguiContext );
+        imguiContext = nullptr;
+    }
+#endif
+}
+
+void RTGL1::LiveEditor::SetEnabled( bool value,
+                                    Scene& scene,
+                                    SceneImportExport& sceneImportExport )
+{
+    if( enabled == value )
+    {
+        return;
+    }
+    enabled = value;
+    workspaceOpen = requestPick = false;
+    selectedLight = -1;
+    selectedSurface = {};
+    statusMessage = enabled ? "RT editor flight mode" : "RT editor disabled";
+    scene.SetEditorCaptureEnabled( enabled );
+    if( enabled )
+    {
+        lightsSeeded = false;
+        sceneImportExport.RequestReimport();
+    }
+    else
+    {
+        scene.SetEditorLights( std::nullopt );
+    }
+}
+
+bool RTGL1::LiveEditor::SubmitInput( const RgEditorInputEvent& event, Scene& scene )
+{
+    if( !enabled || !imguiContext )
+    {
+        return false;
+    }
+    ImGuiContextScope scope( imguiContext );
+    ImGuiIO& io = ImGui::GetIO();
+
+    if( event.type == RG_EDITOR_INPUT_KEY )
+    {
+        if( event.down && event.key == 43 )
+        {
+            workspaceOpen = true;
+            requestedTab = WorkspaceTab::None;
+            statusMessage = "Editor workspace";
+            return true;
+        }
+        if( event.down && event.key == 41 )
+        {
+            workspaceOpen = false;
+            selectedLight = -1;
+            selectedSurface = {};
+            statusMessage = "RT editor flight mode";
+            return true;
+        }
+        if( ImGuiKey key = ToImGuiKey( event.key ); key != ImGuiKey_None )
+        {
+            io.AddKeyEvent( key, event.down != 0 );
+        }
+        io.AddKeyEvent( ImGuiMod_Ctrl, ( event.modifiers & 1 ) != 0 );
+        io.AddKeyEvent( ImGuiMod_Shift, ( event.modifiers & 2 ) != 0 );
+        io.AddKeyEvent( ImGuiMod_Alt, ( event.modifiers & 4 ) != 0 );
+        io.AddKeyEvent( ImGuiMod_Super, ( event.modifiers & 8 ) != 0 );
+    }
+    else if( event.type == RG_EDITOR_INPUT_TEXT )
+    {
+        io.AddInputCharactersUTF8( event.text );
+    }
+    else if( event.type == RG_EDITOR_INPUT_MOUSE_MOVE )
+    {
+        mouseX = event.x;
+        mouseY = event.y;
+        io.AddMousePosEvent( event.x, event.y );
+    }
+    else if( event.type == RG_EDITOR_INPUT_MOUSE_BUTTON )
+    {
+        if( event.button >= 0 && event.button < 5 )
+        {
+            io.AddMouseButtonEvent( event.button, event.down != 0 );
+        }
+        if( !workspaceOpen && event.button == 0 && event.down )
+        {
+            requestPick = true;
+            scene.RequestEditorDynamicCapture();
+            return true;
+        }
+    }
+    else if( event.type == RG_EDITOR_INPUT_MOUSE_WHEEL )
+    {
+        io.AddMouseWheelEvent( 0.0f, event.wheel );
+    }
+    return workspaceOpen;
+}
+
+void RTGL1::LiveEditor::GetStatus( RgEditorStatus& status ) const
+{
+    status = {};
+    status.available = true;
+    status.active = enabled;
+    status.workspaceOpen = workspaceOpen;
+    status.wantsInput = workspaceOpen;
+    status.wantsCursor = workspaceOpen;
+    status.hasUnsavedChanges = hasUnsavedChanges;
+    status.mapSerial = mapSerial;
+    std::snprintf( status.mapName, std::size( status.mapName ), "%s", currentMap.c_str() );
+    std::snprintf( status.message, std::size( status.message ), "%s", statusMessage.c_str() );
+}
+
+void RTGL1::LiveEditor::OnMap( std::string_view mapName,
+                               Scene& scene,
+                               SceneImportExport& sceneImportExport,
+                               SceneMetaManager& sceneMeta,
+                               TextureMetaManager& textureMeta )
+{
+    if( currentMap == mapName )
+    {
+        return;
+    }
+    currentMap = mapName;
+    mapSerial++;
+    workspaceOpen = requestPick = false;
+    selectedLight = -1;
+    selectedSurface = {};
+    lights.clear();
+    lightUndo.clear();
+    lightRedo.clear();
+    lightsSeeded = false;
+    lightIdCounter = 1;
+    selectedTexture.clear();
+    textureEdit = {};
+    textureEditPerScene = texturePerScene;
+    sceneEdit = sceneMeta.Access( currentMap ).value_or( SceneMeta{} );
+    sceneEdit.sceneName = currentMap;
+    sceneMeta.SetLiveOverride( currentMap, sceneEdit );
+    textureMeta.ClearLiveOverrides();
+
+    scenesDocument = std::make_unique< LiveEditorDocument >( sceneMeta.GetPath(), backupFolder );
+    globalTexturesDocument =
+        std::make_unique< LiveEditorDocument >( textureMeta.GetGlobalPath(), backupFolder );
+    sceneTexturesDocument =
+        std::make_unique< LiveEditorDocument >( textureMeta.GetScenePath(), backupFolder );
+    gltfDocument = std::make_unique< LiveEditorDocument >(
+        sceneImportExport.MakeGltfPath( currentMap ), backupFolder );
+
+    std::string error;
+    for( auto* document : { scenesDocument.get(),
+                            globalTexturesDocument.get(),
+                            sceneTexturesDocument.get(),
+                            gltfDocument.get() } )
+    {
+        if( document && !document->Load( error ) )
+        {
+            statusMessage = error;
+        }
+    }
+
+    LoadStoredLights();
+    scene.SetEditorCaptureEnabled( enabled );
+    if( enabled )
+    {
+        sceneImportExport.RequestReimport();
+    }
+}
+
+bool RTGL1::LiveEditor::LoadStoredLights()
+{
+    if( !gltfDocument ) return false;
+    if( auto stored = json_parser::ReadEditorGltf( gltfDocument->Path() );
+        stored && stored->rt_suppress_original_lights )
+    {
+        for( const EditorGltfLight& source : stored->rt_editor_lights )
+        {
+            uint64_t id{};
+            try
+            {
+                id = std::stoull( source.rt_editor_id );
+            }
+            catch( const std::exception& )
+            {
+                id = std::hash< std::string >{}( source.rt_editor_id );
+            }
+            const int type = source.type == "spot" ? 1 : source.type == "directional" ? 2 : 0;
+            const RgFloat3D position{ RG_ACCESS_VEC3( source.position ) };
+            const RgFloat3D direction =
+                Utils::SafeNormalize( { RG_ACCESS_VEC3( source.direction ) }, { 0, 0, -1 } );
+            GenericLight value = MakeLight( type,
+                                            id,
+                                            position,
+                                            direction,
+                                            Utils::PackColor( source.color[ 0 ],
+                                                              source.color[ 1 ],
+                                                              source.color[ 2 ],
+                                                              255 ),
+                                            source.intensity,
+                                            { .exists = true,
+                                              .lightstyle = source.lightstyle,
+                                              .isVolumetric = source.isVolumetric } );
+            if( auto point = std::get_if< RgSphericalLightUploadInfo >( &value ) )
+                point->radius = source.rt_source_radius;
+            if( auto spot = std::get_if< RgSpotLightUploadInfo >( &value ) )
+            {
+                spot->radius = source.rt_source_radius;
+                spot->angleInner = source.innerConeAngle;
+                spot->angleOuter = source.outerConeAngle;
+            }
+            if( auto sun = std::get_if< RgDirectionalLightUploadInfo >( &value ) )
+                sun->angularDiameterDegrees = source.rt_angular_diameter_degrees;
+            lights.push_back( { .id = source.rt_editor_id,
+                                .name = source.name,
+                                .value = value,
+                                .nodePosition = position } );
+        }
+        lightsSeeded = true;
+        return true;
+    }
+    return false;
+}
+
+void RTGL1::LiveEditor::PollExternalChanges( SceneImportExport& sceneImportExport,
+                                             SceneMetaManager& sceneMeta,
+                                             TextureMetaManager& textureMeta )
+{
+    std::string error;
+    bool scenesReloaded = false;
+    bool globalReloaded = false;
+    bool mapTexturesReloaded = false;
+    bool gltfReloaded = false;
+    auto poll = [ & ]( LiveEditorDocument* document, bool& reloaded ) {
+        if( document && !document->ReloadIfClean( error, &reloaded ) && !error.empty() )
+            statusMessage = error;
+    };
+    poll( scenesDocument.get(), scenesReloaded );
+    poll( globalTexturesDocument.get(), globalReloaded );
+    poll( sceneTexturesDocument.get(), mapTexturesReloaded );
+    poll( gltfDocument.get(), gltfReloaded );
+
+    if( scenesReloaded )
+    {
+        sceneMeta.ClearLiveOverrides();
+        sceneMeta.OnFileChanged( FileType::JSON, sceneMeta.GetPath() );
+        sceneEdit = sceneMeta.Access( currentMap ).value_or( SceneMeta{} );
+        sceneEdit.sceneName = currentMap;
+        sceneMeta.SetLiveOverride( currentMap, sceneEdit );
+        statusMessage = "Reloaded externally changed scenes.json";
+    }
+    if( globalReloaded || mapTexturesReloaded )
+    {
+        textureMeta.ClearLiveOverrides();
+        textureMeta.RereadFromFiles( std::string_view( currentMap ) );
+        if( !selectedTexture.empty() )
+        {
+            textureEdit = textureMeta.AccessConfig( selectedTexture, texturePerScene )
+                              .value_or( TextureMetaConfig{} );
+            textureEdit.textureName = selectedTexture;
+        }
+        sceneImportExport.RequestReimport();
+        statusMessage = "Reloaded externally changed textures.json";
+    }
+    if( gltfReloaded )
+    {
+        lights.clear();
+        lightUndo.clear();
+        lightRedo.clear();
+        lightsSeeded = false;
+        if( !LoadStoredLights() ) deferLightSeed = true;
+        sceneImportExport.RequestReimport();
+        statusMessage = "Reloaded externally changed map glTF";
+    }
+}
+
+void RTGL1::LiveEditor::DiscardConflictsAndReload( SceneImportExport& sceneImportExport,
+                                                   SceneMetaManager& sceneMeta,
+                                                   TextureMetaManager& textureMeta )
+{
+    std::string error;
+    bool failed = false;
+    auto reload = [ & ]( LiveEditorDocument* document ) {
+        if( document && document->HasExternalConflict() && !document->DiscardAndReload( error ) )
+            failed = true;
+    };
+    reload( scenesDocument.get() );
+    reload( globalTexturesDocument.get() );
+    reload( sceneTexturesDocument.get() );
+    reload( gltfDocument.get() );
+    if( failed )
+    {
+        statusMessage = error;
+        return;
+    }
+
+    sceneMeta.ClearLiveOverrides();
+    sceneMeta.OnFileChanged( FileType::JSON, sceneMeta.GetPath() );
+    sceneEdit = sceneMeta.Access( currentMap ).value_or( SceneMeta{} );
+    sceneEdit.sceneName = currentMap;
+    sceneMeta.SetLiveOverride( currentMap, sceneEdit );
+    textureMeta.ClearLiveOverrides();
+    textureMeta.RereadFromFiles( std::string_view( currentMap ) );
+    if( !selectedTexture.empty() )
+    {
+        textureEdit = textureMeta.AccessConfig( selectedTexture, texturePerScene )
+                          .value_or( TextureMetaConfig{} );
+        textureEdit.textureName = selectedTexture;
+    }
+    lights.clear();
+    lightUndo.clear();
+    lightRedo.clear();
+    lightsSeeded = false;
+    if( !LoadStoredLights() ) deferLightSeed = true;
+    sceneImportExport.RequestReimport();
+    statusMessage = "Discarded the conflicting editor action and reloaded external files";
+}
+
+void RTGL1::LiveEditor::SeedLights( const Scene& scene )
+{
+    if( lightsSeeded )
+    {
+        return;
+    }
+    lights.clear();
+    size_t index = 1;
+    for( const GenericLight& value : scene.GetStaticLights() )
+    {
+        if( std::holds_alternative< RgPolygonalLightUploadInfo >( value ) )
+        {
+            continue;
+        }
+        EditableLight editable{
+            .id = std::to_string( LightId( value ) ),
+            .name = "Light " + std::to_string( index++ ),
+            .value = value,
+            .nodePosition = LightPosition( value, {} ),
+        };
+        lights.push_back( std::move( editable ) );
+    }
+    lightsSeeded = true;
+}
+
+void RTGL1::LiveEditor::ApplyLights( Scene& scene ) const
+{
+    if( !enabled || !lightsSeeded )
+    {
+        return;
+    }
+    std::vector< GenericLight > values;
+    values.reserve( lights.size() );
+    for( const EditableLight& light : lights )
+    {
+        values.push_back( light.value );
+    }
+    scene.SetEditorLights( std::move( values ) );
+}
+
+void RTGL1::LiveEditor::PickAtReticle( const RgDrawFrameInfo& drawInfo, const Scene& scene )
+{
+    requestPick = false;
+    float inv[ 16 ];
+    Matrix::Inverse( inv, drawInfo.view );
+    RgFloat3D origin{ inv[ 12 ], inv[ 13 ], inv[ 14 ] };
+    RgFloat3D direction = Utils::SafeNormalize( { -inv[ 8 ], -inv[ 9 ], -inv[ 10 ] },
+                                                { 0, 0, -1 } );
+
+    float bestLight = std::numeric_limits< float >::max();
+    int hitLight = -1;
+    for( size_t i = 0; i < lights.size(); i++ )
+    {
+        RgFloat3D point = LightPosition( lights[ i ].value, lights[ i ].nodePosition );
+        if( std::holds_alternative< RgDirectionalLightUploadInfo >( lights[ i ].value ) )
+        {
+            RgFloat3D d = LightDirection( lights[ i ].value );
+            point = { origin.data[ 0 ] - d.data[ 0 ] * 128.0f,
+                      origin.data[ 1 ] - d.data[ 1 ] * 128.0f,
+                      origin.data[ 2 ] - d.data[ 2 ] * 128.0f };
+        }
+        const float vx = point.data[ 0 ] - origin.data[ 0 ];
+        const float vy = point.data[ 1 ] - origin.data[ 1 ];
+        const float vz = point.data[ 2 ] - origin.data[ 2 ];
+        const float along = vx * direction.data[ 0 ] + vy * direction.data[ 1 ] +
+                            vz * direction.data[ 2 ];
+        if( along <= 0 )
+        {
+            continue;
+        }
+        const float px = vx - direction.data[ 0 ] * along;
+        const float py = vy - direction.data[ 1 ] * along;
+        const float pz = vz - direction.data[ 2 ] * along;
+        const float perpendicular = std::sqrt( px * px + py * py + pz * pz );
+        if( perpendicular < std::max( 3.0f, along * 0.015f ) && along < bestLight )
+        {
+            bestLight = along;
+            hitLight = static_cast< int >( i );
+        }
+    }
+    if( hitLight >= 0 )
+    {
+        selectedLight = hitLight;
+        selectedSurface = {};
+        workspaceOpen = true;
+        requestedTab = WorkspaceTab::Lights;
+        return;
+    }
+
+    float nearest = std::numeric_limits< float >::max();
+    SurfaceSelection result{};
+    auto test = [ & ]( const std::vector< Scene::PickPrimitive >& primitives ) {
+        for( const auto& primitive : primitives )
+        {
+            for( size_t i = 0; i + 2 < primitive.indices.size(); i += 3 )
+            {
+                const uint32_t ia = primitive.indices[ i + 0 ];
+                const uint32_t ib = primitive.indices[ i + 1 ];
+                const uint32_t ic = primitive.indices[ i + 2 ];
+                if( ia >= primitive.positions.size() || ib >= primitive.positions.size() ||
+                    ic >= primitive.positions.size() )
+                {
+                    continue;
+                }
+                float distance{};
+                if( RayTriangle( origin,
+                                 direction,
+                                 primitive.positions[ ia ],
+                                 primitive.positions[ ib ],
+                                 primitive.positions[ ic ],
+                                 distance ) &&
+                    distance < nearest )
+                {
+                    nearest = distance;
+                    result = {
+                        .valid = true,
+                        .objectId = primitive.uniqueObjectID,
+                        .primitiveIndex = primitive.primitiveIndex,
+                        .meshName = primitive.meshName,
+                        .primitiveName = primitive.primitiveName,
+                        .textureName = primitive.textureName,
+                        .hitPosition = { origin.data[ 0 ] + direction.data[ 0 ] * distance,
+                                         origin.data[ 1 ] + direction.data[ 1 ] * distance,
+                                         origin.data[ 2 ] + direction.data[ 2 ] * distance },
+                    };
+                }
+            }
+        }
+    };
+    test( scene.GetStaticPickPrimitives() );
+    test( scene.GetDynamicPickPrimitives() );
+    selectedSurface = std::move( result );
+    selectedLight = -1;
+    if( selectedSurface.valid )
+    {
+        selectedTexture = selectedSurface.textureName;
+        workspaceOpen = true;
+        requestedTab = WorkspaceTab::Surface;
+    }
+}
+
+void RTGL1::LiveEditor::Draw( const RgDrawFrameInfo& drawInfo,
+                              uint32_t displayWidth,
+                              uint32_t displayHeight,
+                              uint32_t frameIndex,
+                              VkCommandBuffer materialCmd,
+                              Scene& scene,
+                              SceneImportExport& sceneImportExport,
+                              SceneMetaManager& sceneMeta,
+                              TextureMetaManager& textureMeta,
+                              TextureManager& textureManager,
+                              Rasterizer& rasterizer )
+{
+#ifndef RG_USE_IMGUI
+    return;
+#else
+    OnMap( sceneImportExport.GetImportMapName(),
+           scene,
+           sceneImportExport,
+           sceneMeta,
+           textureMeta );
+    if( !enabled || !imguiContext )
+    {
+        return;
+    }
+
+    PollExternalChanges( sceneImportExport, sceneMeta, textureMeta );
+    if( deferLightSeed )
+    {
+        deferLightSeed = false;
+    }
+    else
+    {
+        SeedLights( scene );
+        ApplyLights( scene );
+    }
+    if( requestPick )
+    {
+        PickAtReticle( drawInfo, scene );
+    }
+
+    ImGuiContextScope scope( imguiContext );
+    ImGuiIO& io = ImGui::GetIO();
+    io.DisplaySize = ImVec2( static_cast< float >( displayWidth ),
+                             static_cast< float >( displayHeight ) );
+    io.DeltaTime = 1.0f / 60.0f;
+    ImGui::NewFrame();
+    ImGuizmo::BeginFrame();
+
+    DrawReticleAndGlyphs( drawInfo );
+    if( workspaceOpen )
+    {
+        DrawWorkspace( drawInfo,
+                       scene,
+                       sceneImportExport,
+                       sceneMeta,
+                       textureMeta,
+                       textureManager );
+    }
+
+    ImGui::Render();
+    RenderImGui( frameIndex, materialCmd, textureManager, rasterizer );
+
+    hasUnsavedChanges =
+        ( scenesDocument && scenesDocument->IsDirty() ) ||
+        ( globalTexturesDocument && globalTexturesDocument->IsDirty() ) ||
+        ( sceneTexturesDocument && sceneTexturesDocument->IsDirty() ) ||
+        ( gltfDocument && gltfDocument->IsDirty() );
+#endif
+}
+
+void RTGL1::LiveEditor::DrawWorkspace( const RgDrawFrameInfo& drawInfo,
+                                       Scene& scene,
+                                       SceneImportExport& sceneImportExport,
+                                       SceneMetaManager& sceneMeta,
+                                       TextureMetaManager& textureMeta,
+                                       TextureManager& textureManager )
+{
+    ImGui::SetNextWindowSize( ImVec2( 520, 720 ), ImGuiCond_FirstUseEver );
+    ImGui::SetNextWindowPos( ImVec2( 16, 16 ), ImGuiCond_FirstUseEver );
+    if( !ImGui::Begin( "RT Live Editor", &workspaceOpen, ImGuiWindowFlags_MenuBar ) )
+    {
+        ImGui::End();
+        return;
+    }
+    if( ImGui::BeginMenuBar() )
+    {
+        ImGui::TextUnformatted( currentMap.c_str() );
+        ImGui::Separator();
+        if( hasUnsavedChanges )
+        {
+            ImGui::TextColored( ImVec4( 1, 0.45f, 0.2f, 1 ), "Unsaved" );
+        }
+        else
+        {
+            ImGui::TextColored( ImVec4( 0.45f, 1, 0.45f, 1 ), "Saved" );
+        }
+        ImGui::EndMenuBar();
+    }
+    if( !statusMessage.empty() )
+    {
+        ImGui::TextWrapped( "%s", statusMessage.c_str() );
+    }
+
+    const bool externalConflict =
+        ( scenesDocument && scenesDocument->HasExternalConflict() ) ||
+        ( globalTexturesDocument && globalTexturesDocument->HasExternalConflict() ) ||
+        ( sceneTexturesDocument && sceneTexturesDocument->HasExternalConflict() ) ||
+        ( gltfDocument && gltfDocument->HasExternalConflict() );
+    if( externalConflict )
+    {
+        ImGui::PushStyleColor( ImGuiCol_Text, ImVec4( 1.0f, 0.35f, 0.2f, 1.0f ) );
+        ImGui::TextWrapped( "A file changed externally during an editor action. Saving is blocked so the external edit cannot be overwritten." );
+        ImGui::PopStyleColor();
+        if( ImGui::Button( "Discard editor action and reload external files" ) )
+            DiscardConflictsAndReload( sceneImportExport, sceneMeta, textureMeta );
+    }
+
+    if( ImGui::BeginTabBar( "Workspace" ) )
+    {
+        if( ImGui::BeginTabItem( "Lights",
+                                 nullptr,
+                                 requestedTab == WorkspaceTab::Lights
+                                     ? ImGuiTabItemFlags_SetSelected
+                                     : ImGuiTabItemFlags_None ) )
+        {
+            DrawLightPanel( drawInfo, scene );
+            ImGui::EndTabItem();
+        }
+        if( ImGui::BeginTabItem( "Atmosphere",
+                                 nullptr,
+                                 requestedTab == WorkspaceTab::Atmosphere
+                                     ? ImGuiTabItemFlags_SetSelected
+                                     : ImGuiTabItemFlags_None ) )
+        {
+            DrawAtmospherePanel( sceneMeta );
+            ImGui::EndTabItem();
+        }
+        if( ImGui::BeginTabItem( "Textures",
+                                 nullptr,
+                                 requestedTab == WorkspaceTab::Textures
+                                     ? ImGuiTabItemFlags_SetSelected
+                                     : ImGuiTabItemFlags_None ) )
+        {
+            DrawTexturePanel( textureMeta, textureManager, sceneImportExport );
+            ImGui::EndTabItem();
+        }
+        if( ImGui::BeginTabItem( "Selected surface",
+                                 nullptr,
+                                 requestedTab == WorkspaceTab::Surface
+                                     ? ImGuiTabItemFlags_SetSelected
+                                     : ImGuiTabItemFlags_None ) )
+        {
+            DrawMeshPanel();
+            ImGui::EndTabItem();
+        }
+        ImGui::EndTabBar();
+        requestedTab = WorkspaceTab::None;
+    }
+    ImGui::Separator();
+    ImGui::TextDisabled( "Escape: return to flight   Tab: open workspace   F10: exit editor" );
+    ImGui::End();
+}
+
+void RTGL1::LiveEditor::BeginLightAction()
+{
+    if( lightAction )
+    {
+        return;
+    }
+    lightActionStart = lights;
+    lightAction = true;
+    if( gltfDocument )
+    {
+        gltfDocument->BeginAction();
+    }
+}
+
+void RTGL1::LiveEditor::EndLightAction( bool changed, Scene& scene )
+{
+    if( !lightAction )
+    {
+        return;
+    }
+    lightAction = false;
+    if( !changed )
+    {
+        if( gltfDocument )
+        {
+            gltfDocument->CancelAction();
+        }
+        return;
+    }
+    lightUndo.push_back( std::move( lightActionStart ) );
+    lightRedo.clear();
+    ApplyLights( scene );
+    SaveLights();
+}
+
+void RTGL1::LiveEditor::UndoLights( Scene& scene )
+{
+    if( lightUndo.empty() )
+    {
+        return;
+    }
+    lightRedo.push_back( lights );
+    lights = std::move( lightUndo.back() );
+    lightUndo.pop_back();
+    selectedLight = std::min( selectedLight, static_cast< int >( lights.size() ) - 1 );
+    ApplyLights( scene );
+    if( gltfDocument )
+    {
+        gltfDocument->BeginAction();
+    }
+    SaveLights();
+}
+
+void RTGL1::LiveEditor::RedoLights( Scene& scene )
+{
+    if( lightRedo.empty() )
+    {
+        return;
+    }
+    lightUndo.push_back( lights );
+    lights = std::move( lightRedo.back() );
+    lightRedo.pop_back();
+    ApplyLights( scene );
+    if( gltfDocument )
+    {
+        gltfDocument->BeginAction();
+    }
+    SaveLights();
+}
+
+uint64_t RTGL1::LiveEditor::NewLightId()
+{
+    for( ;; )
+    {
+        const uint64_t candidate = ( uint64_t( mapSerial ) << 32 ) | lightIdCounter++;
+        const std::string text = std::to_string( candidate );
+        if( std::ranges::none_of( lights,
+                                 [ & ]( const EditableLight& light ) {
+                                     return light.id == text || LightId( light.value ) == candidate;
+                                 } ) )
+        {
+            return candidate;
+        }
+    }
+}
+
+void RTGL1::LiveEditor::DrawLightPanel( const RgDrawFrameInfo& drawInfo, Scene& scene )
+{
+    float inverseView[ 16 ];
+    Matrix::Inverse( inverseView, drawInfo.view );
+    const RgFloat3D createPosition{ inverseView[ 12 ] - inverseView[ 8 ] * 64.0f,
+                                    inverseView[ 13 ] - inverseView[ 9 ] * 64.0f,
+                                    inverseView[ 14 ] - inverseView[ 10 ] * 64.0f };
+    const RgFloat3D createDirection = Utils::SafeNormalize(
+        { -inverseView[ 8 ], -inverseView[ 9 ], -inverseView[ 10 ] },
+        { 0, 0, -1 } );
+    if( ImGui::Button( "Create point" ) )
+    {
+        BeginLightAction();
+        const uint64_t id = NewLightId();
+        lights.push_back( { .id = std::to_string( id ),
+                            .name = "Point light",
+                            .value = MakeLight( 0,
+                                                id,
+                                                createPosition,
+                                                { 0, 0, -1 },
+                                                0xFFFFFFFF,
+                                                500.0f,
+                                                { .exists = true } ),
+                            .nodePosition = createPosition } );
+        selectedLight = static_cast< int >( lights.size() ) - 1;
+        EndLightAction( true, scene );
+    }
+    ImGui::SameLine();
+    if( ImGui::Button( "Create spot" ) )
+    {
+        BeginLightAction();
+        const uint64_t id = NewLightId();
+        lights.push_back( { .id = std::to_string( id ),
+                            .name = "Spot light",
+                             .value = MakeLight( 1,
+                                                 id,
+                                                 createPosition,
+                                                 createDirection,
+                                                 0xFFFFFFFF,
+                                                500.0f,
+                                                { .exists = true } ),
+                            .nodePosition = createPosition } );
+        selectedLight = static_cast< int >( lights.size() ) - 1;
+        EndLightAction( true, scene );
+    }
+    ImGui::SameLine();
+    if( ImGui::Button( "Create sun" ) )
+    {
+        BeginLightAction();
+        const uint64_t id = NewLightId();
+        lights.push_back( { .id = std::to_string( id ),
+                            .name = "Directional light",
+                             .value = MakeLight( 2,
+                                                 id,
+                                                 createPosition,
+                                                 createDirection,
+                                                 0xFFFFFFFF,
+                                                3.0f,
+                                                { .exists = true } ),
+                            .nodePosition = createPosition } );
+        selectedLight = static_cast< int >( lights.size() ) - 1;
+        EndLightAction( true, scene );
+    }
+
+    ImGui::BeginChild( "LightList", ImVec2( 0, 150 ), true );
+    for( size_t i = 0; i < lights.size(); i++ )
+    {
+        std::string label = lights[ i ].name + "##" + lights[ i ].id;
+        if( ImGui::Selectable( label.c_str(), selectedLight == static_cast< int >( i ) ) )
+        {
+            selectedLight = static_cast< int >( i );
+            selectedSurface = {};
+        }
+    }
+    ImGui::EndChild();
+
+    ImGui::BeginDisabled( lightUndo.empty() );
+    if( ImGui::Button( "Undo" ) ) UndoLights( scene );
+    ImGui::EndDisabled();
+    ImGui::SameLine();
+    ImGui::BeginDisabled( lightRedo.empty() );
+    if( ImGui::Button( "Redo" ) ) RedoLights( scene );
+    ImGui::EndDisabled();
+
+    if( selectedLight < 0 || selectedLight >= static_cast< int >( lights.size() ) )
+    {
+        ImGui::TextDisabled( "Select a light or click a light glyph in flight mode." );
+        return;
+    }
+    EditableLight& editable = lights[ selectedLight ];
+    char name[ 128 ];
+    std::snprintf( name, std::size( name ), "%s", editable.name.c_str() );
+    if( ImGui::InputText( "Name", name, std::size( name ), ImGuiInputTextFlags_EnterReturnsTrue ) )
+    {
+        editable.name = name;
+    }
+    if( ImGui::IsItemActivated() ) BeginLightAction();
+    if( ImGui::IsItemDeactivatedAfterEdit() )
+    {
+        editable.name = name;
+        EndLightAction( true, scene );
+    }
+
+    int type = std::strcmp( LightType( editable.value ), "point" ) == 0 ? 0
+               : std::strcmp( LightType( editable.value ), "spot" ) == 0 ? 1
+                                                                          : 2;
+    const char* types[] = { "Point", "Spot", "Directional" };
+    if( ImGui::Combo( "Type", &type, types, 3 ) )
+    {
+        BeginLightAction();
+        editable.value = MakeLight( type,
+                                    LightId( editable.value ),
+                                    LightPosition( editable.value, editable.nodePosition ),
+                                    LightDirection( editable.value ),
+                                    LightColor( editable.value ),
+                                    LightIntensity( editable.value ),
+                                    LightExtra( editable.value ) );
+        EndLightAction( true, scene );
+    }
+
+    RgFloat3D position = LightPosition( editable.value, editable.nodePosition );
+    if( ImGui::DragFloat3( "Translation", position.data, 1.0f ) )
+    {
+        if( ImGui::IsItemActivated() ) BeginLightAction();
+        editable.nodePosition = position;
+        if( auto point = std::get_if< RgSphericalLightUploadInfo >( &editable.value ) )
+            point->position = position;
+        if( auto spot = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+            spot->position = position;
+        ApplyLights( scene );
+    }
+    if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+
+    RgFloat3D direction = LightDirection( editable.value );
+    if( ImGui::DragFloat3( "Direction", direction.data, 0.01f, -1.0f, 1.0f ) )
+    {
+        if( ImGui::IsItemActivated() ) BeginLightAction();
+        direction = Utils::SafeNormalize( direction, { 0, 0, -1 } );
+        if( auto sun = std::get_if< RgDirectionalLightUploadInfo >( &editable.value ) )
+            sun->direction = direction;
+        if( auto spot = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+            spot->direction = direction;
+        ApplyLights( scene );
+    }
+    if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+
+    auto colorBytes = Utils::UnpackColor4DPacked32Components( LightColor( editable.value ) );
+    float color[] = { colorBytes[ 0 ] / 255.0f,
+                      colorBytes[ 1 ] / 255.0f,
+                      colorBytes[ 2 ] / 255.0f };
+    if( ImGui::ColorEdit3( "Color", color ) )
+    {
+        if( ImGui::IsItemActivated() ) BeginLightAction();
+        LightColor( editable.value ) = Utils::PackColorFromFloat( color[ 0 ], color[ 1 ], color[ 2 ], 1 );
+        ApplyLights( scene );
+    }
+    if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+
+    if( ImGui::DragFloat( "Intensity", &LightIntensity( editable.value ), 1.0f, 0.0f, 1000000.0f ) )
+    {
+        if( ImGui::IsItemActivated() ) BeginLightAction();
+        LightIntensity( editable.value ) = std::max( 0.0f, LightIntensity( editable.value ) );
+        ApplyLights( scene );
+    }
+    if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+
+    if( auto point = std::get_if< RgSphericalLightUploadInfo >( &editable.value ) )
+    {
+        if( ImGui::DragFloat( "Source radius", &point->radius, 0.01f, 0.0f, 10000.0f ) )
+        {
+            if( ImGui::IsItemActivated() ) BeginLightAction();
+            ApplyLights( scene );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+    }
+    if( auto spot = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+    {
+        if( ImGui::DragFloat( "Source radius", &spot->radius, 0.01f, 0.0f, 10000.0f ) )
+        {
+            if( ImGui::IsItemActivated() ) BeginLightAction();
+            ApplyLights( scene );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+        if( ImGui::SliderAngle( "Inner cone", &spot->angleInner, 0, 89 ) )
+        {
+            if( ImGui::IsItemActivated() ) BeginLightAction();
+            spot->angleInner = std::min( spot->angleInner, spot->angleOuter );
+            ApplyLights( scene );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+        if( ImGui::SliderAngle( "Outer cone", &spot->angleOuter, 0, 89 ) )
+        {
+            if( ImGui::IsItemActivated() ) BeginLightAction();
+            spot->angleOuter = std::max( spot->angleOuter, spot->angleInner );
+            ApplyLights( scene );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+    }
+    if( auto sun = std::get_if< RgDirectionalLightUploadInfo >( &editable.value ) )
+    {
+        if( ImGui::DragFloat( "Angular diameter (degrees)",
+                              &sun->angularDiameterDegrees,
+                              0.01f,
+                              0.0f,
+                              180.0f ) )
+        {
+            if( ImGui::IsItemActivated() ) BeginLightAction();
+            ApplyLights( scene );
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+    }
+
+    auto& extra = LightExtra( editable.value );
+    extra.exists = true;
+    if( ImGui::SliderInt( "Lightstyle", &extra.lightstyle, 0, 63 ) )
+    {
+        if( ImGui::IsItemActivated() ) BeginLightAction();
+        ApplyLights( scene );
+    }
+    if( ImGui::IsItemDeactivatedAfterEdit() ) EndLightAction( true, scene );
+    bool volumetric = extra.isVolumetric != 0;
+    if( ImGui::Checkbox( "Volumetric source", &volumetric ) )
+    {
+        BeginLightAction();
+        extra.isVolumetric = volumetric;
+        EndLightAction( true, scene );
+    }
+
+    if( ImGui::Button( "Duplicate" ) )
+    {
+        BeginLightAction();
+        EditableLight copy = editable;
+        const uint64_t id = NewLightId();
+        copy.id = std::to_string( id );
+        copy.name += " copy";
+        std::visit( [ id ]( auto& value ) { value.uniqueID = id; }, copy.value );
+        lights.push_back( std::move( copy ) );
+        selectedLight = static_cast< int >( lights.size() ) - 1;
+        EndLightAction( true, scene );
+    }
+    ImGui::SameLine();
+    if( ImGui::Button( "Delete" ) )
+    {
+        BeginLightAction();
+        lights.erase( lights.begin() + selectedLight );
+        selectedLight = std::min( selectedLight, static_cast< int >( lights.size() ) - 1 );
+        EndLightAction( true, scene );
+        return;
+    }
+
+    // In-viewport transform gizmo. Translation is retained even for a sun node,
+    // where it intentionally has no illumination effect.
+    RgTransform transform = Utils::MakeTransform( position, direction );
+    float matrix[ 16 ] = RG_TRANSFORM_TO_GLTF_MATRIX( transform );
+    float projection[ 16 ];
+    ImGuiIO& io = ImGui::GetIO();
+    Matrix::MakeProjectionMatrix( projection,
+                                  io.DisplaySize.x / io.DisplaySize.y,
+                                  drawInfo.fovYRadians,
+                                  drawInfo.cameraNear,
+                                  drawInfo.cameraFar );
+    projection[ 1 * 4 + 1 ] = -projection[ 1 * 4 + 1 ];
+    ImGuizmo::SetOrthographic( false );
+    ImGuizmo::SetDrawlist( ImGui::GetForegroundDrawList() );
+    ImGuizmo::SetRect( 0, 0, io.DisplaySize.x, io.DisplaySize.y );
+    static ImGuizmo::OPERATION operation = ImGuizmo::TRANSLATE;
+    if( ImGui::RadioButton( "Move gizmo", operation == ImGuizmo::TRANSLATE ) )
+        operation = ImGuizmo::TRANSLATE;
+    ImGui::SameLine();
+    if( ImGui::RadioButton( "Rotate gizmo", operation == ImGuizmo::ROTATE ) )
+        operation = ImGuizmo::ROTATE;
+    const bool wasUsing = ImGuizmo::IsUsing();
+    ImGuizmo::Manipulate( drawInfo.view,
+                          projection,
+                          operation,
+                          ImGuizmo::WORLD,
+                          matrix );
+    const bool isUsing = ImGuizmo::IsUsing();
+    if( isUsing && !wasUsing ) BeginLightAction();
+    if( isUsing )
+    {
+        editable.nodePosition = { matrix[ 12 ], matrix[ 13 ], matrix[ 14 ] };
+        RgFloat3D newDirection = Utils::SafeNormalize( { matrix[ 8 ], matrix[ 9 ], matrix[ 10 ] },
+                                                       { 0, 0, -1 } );
+        if( auto point = std::get_if< RgSphericalLightUploadInfo >( &editable.value ) )
+            point->position = editable.nodePosition;
+        if( auto spot = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+        {
+            spot->position = editable.nodePosition;
+            spot->direction = newDirection;
+        }
+        if( auto sun = std::get_if< RgDirectionalLightUploadInfo >( &editable.value ) )
+            sun->direction = newDirection;
+        ApplyLights( scene );
+    }
+    if( !isUsing && wasUsing ) EndLightAction( true, scene );
+}
