diff --git a/Tests/EditorGltfParserTests.cpp b/Tests/EditorGltfParserTests.cpp
new file mode 100644
index 0000000..7b7a900
--- /dev/null
+++ b/Tests/EditorGltfParserTests.cpp
@@ -0,0 +1,95 @@
+// Copyright (c) 2026 They Still Hunger contributors
+// SPDX-License-Identifier: MIT
+
+#include "JsonParser.h"
+
+#include <cassert>
+#include <chrono>
+#include <fstream>
+#include <iostream>
+
+namespace RTGL1::debug::detail
+{
+DebugPrintFn g_print{};
+RgMessageSeverityFlags g_printSeverity{ 0 };
+}
+
+namespace
+{
+bool VerifyParsedFile( const std::filesystem::path& path, bool verifyRegressionValues )
+{
+    const auto parsed = RTGL1::json_parser::ReadEditorGltf( path );
+    if( !parsed )
+    {
+        std::cerr << "Failed to parse " << path << '\n';
+        return false;
+    }
+
+    if( verifyRegressionValues )
+    {
+        if( !parsed->rt_suppress_original_lights || parsed->rt_editor_lights.size() != 1 )
+        {
+            std::cerr << "Parsed regression document has unexpected ownership or light count\n";
+            return false;
+        }
+
+        const auto& light = parsed->rt_editor_lights.front();
+        if( light.rt_editor_id != "18446744073709551615" || light.name != "https://light" ||
+            light.color[ 0 ] != 255 || light.color[ 1 ] != 220 || light.color[ 2 ] != 128 )
+        {
+            std::cerr << "Parsed regression light values do not round-trip\n";
+            return false;
+        }
+    }
+
+    return true;
+}
+}
+
+int main( int argc, char** argv )
+{
+    RTGL1::debug::detail::g_printSeverity = RG_MESSAGE_SEVERITY_WARNING;
+    RTGL1::debug::detail::g_print = []( std::string_view message, RgMessageSeverityFlags ) {
+        std::cerr << message << '\n';
+    };
+
+    const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+    const auto path = std::filesystem::temp_directory_path() /
+                      ( "rtgl-editor-gltf-parser-" + std::to_string( stamp ) + ".gltf" );
+
+    {
+        std::ofstream file( path, std::ios::binary | std::ios::trunc );
+        file << R"({
+  "asset": { "version": "2.0" },
+  "unknownRootProperty": { "preserve": true },
+  "extras": {
+    "rt_suppress_original_lights": true,
+    "rt_editor_lights": [
+      {
+        "rt_editor_id": /* JSONC between key and value */ "18446744073709551615",
+        "name": "https://light",
+        "type": "point",
+        "position": [19.999998, -176.99998, -851],
+        "direction": [0, 0, -1],
+        "color": [255, 220, 128],
+        "intensity": 100
+      }
+    ]
+  }
+})";
+    }
+
+    const bool regressionPassed = VerifyParsedFile( path, true );
+
+    std::error_code ignored;
+    std::filesystem::remove( path, ignored );
+
+    if( !regressionPassed )
+        return 1;
+
+    if( argc > 1 && !VerifyParsedFile( argv[ 1 ], false ) )
+        return 1;
+
+    std::cout << "editor glTF parser regression passed\n";
+    return 0;
+}
diff --git a/Tests/LiveEditorPersistenceTests.cpp b/Tests/LiveEditorPersistenceTests.cpp
new file mode 100644
index 0000000..dc54252
--- /dev/null
+++ b/Tests/LiveEditorPersistenceTests.cpp
@@ -0,0 +1,147 @@
+// Copyright (c) 2026 They Still Hunger contributors
+// SPDX-License-Identifier: MIT
+
+#include "LiveEditorPersistence.h"
+
+#include <cassert>
+#include <chrono>
+#include <fstream>
+#include <sstream>
+
+namespace
+{
+std::string Read( const std::filesystem::path& path )
+{
+    std::ifstream file( path, std::ios::binary );
+    std::ostringstream text;
+    text << file.rdbuf();
+    return text.str();
+}
+
+void Write( const std::filesystem::path& path, std::string_view text )
+{
+    std::filesystem::create_directories( path.parent_path() );
+    std::ofstream file( path, std::ios::binary | std::ios::trunc );
+    file.write( text.data(), static_cast< std::streamsize >( text.size() ) );
+}
+
+bool ValidJsonShape( const std::filesystem::path& path, std::string& error )
+{
+    const std::string text = Read( path );
+    if( text.find( "\"array\"" ) == std::string::npos )
+    {
+        error = "test validator rejected document";
+        return false;
+    }
+    return true;
+}
+}
+
+int main()
+{
+    using RTGL1::LiveEditorDocument;
+    const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+    const auto root = std::filesystem::temp_directory_path() /
+                      ( "rtgl-live-editor-tests-" + std::to_string( stamp ) );
+    const auto backup = root / "backups";
+    const auto path = root / "rt" / "textures.json";
+    const std::string original =
+        "{\n"
+        "  // preserved root comment\n"
+        "  \"version\": 0,\n"
+        "  \"unknownRoot\": { \"keep\": true },\n"
+        "  \"array\": [\n"
+        "    { \"textureName\": \"brick\", \"roughnessDefault\": 0.4, \"unknown\": 7 }\n"
+        "  ]\n"
+        "}\n";
+    Write( path, original );
+
+    std::string error;
+    LiveEditorDocument document( path, backup );
+    assert( document.Load( error ) );
+    document.BeginAction();
+    assert( document.SetArrayObjectField(
+        "array", "textureName", "brick", "roughnessDefault", "0.8", error ) );
+    assert( document.SetArrayObjectField(
+        "array", "textureName", "brick", "metallicDefault", "0.25", error ) );
+    assert( document.EndActionAndSave( ValidJsonShape, error ) );
+    const std::string edited = Read( path );
+    assert( edited.find( "preserved root comment" ) != std::string::npos );
+    assert( edited.find( "\"unknownRoot\"" ) != std::string::npos );
+    assert( edited.find( "\"unknown\": 7" ) != std::string::npos );
+    assert( edited.find( "0.8" ) != std::string::npos );
+    assert( edited.find( "metallicDefault" ) != std::string::npos );
+
+    assert( document.CanUndo() );
+    assert( document.Undo( ValidJsonShape, error ) );
+    assert( Read( path ) == original );
+    assert( document.CanRedo() );
+    assert( document.Redo( ValidJsonShape, error ) );
+    assert( Read( path ) == edited );
+
+    document.BeginAction();
+    assert( document.SetArrayObjectField(
+        "array", "textureName", "brick", "metallicDefault", std::nullopt, error ) );
+    assert( document.EndActionAndSave( ValidJsonShape, error ) );
+    assert( Read( path ).find( "metallicDefault" ) == std::string::npos );
+
+    const std::string beforeRejectedSave = Read( path );
+    document.BeginAction();
+    assert( document.SetArrayObjectField(
+        "array", "textureName", "brick", "roughnessDefault", "0.1", error ) );
+    const auto reject = []( const std::filesystem::path&, std::string& message ) {
+        message = "intentional validation failure";
+        return false;
+    };
+    assert( !document.EndActionAndSave( reject, error ) );
+    assert( document.IsDirty() );
+    assert( Read( path ) == beforeRejectedSave );
+    assert( document.RetrySave( ValidJsonShape, error ) );
+    assert( !document.IsDirty() );
+
+    document.BeginAction();
+    assert( document.SetRootObjectField( "extras", "rt_suppress_original_lights", "true", error ) );
+    assert( document.SetRootObjectField( "extras", "rt_editor_lights", "[]", error ) );
+    assert( document.EndActionAndSave( ValidJsonShape, error ) );
+    const std::string withExtras = Read( path );
+    assert( withExtras.find( "\"extras\"" ) != std::string::npos );
+    assert( withExtras.find( "rt_suppress_original_lights" ) != std::string::npos );
+    assert( withExtras.find( "\"unknownRoot\"" ) != std::string::npos );
+
+    document.BeginAction();
+    assert( document.SetArrayObjectField(
+        "array", "textureName", "brick", "roughnessDefault", "0.2", error ) );
+    const std::string external = original + "\n";
+    Write( path, external );
+    assert( !document.EndActionAndSave( ValidJsonShape, error ) );
+    assert( document.HasExternalConflict() );
+    assert( Read( path ) == external );
+    assert( document.DiscardAndReload( error ) );
+    assert( !document.HasExternalConflict() );
+
+    // A second document for the same path must preserve the session's first backup.
+    const auto backupFile = backup / "rt_textures.json.bak";
+    assert( std::filesystem::exists( backupFile ) );
+    const std::string firstBackup = Read( backupFile );
+    LiveEditorDocument second( path, backup );
+    assert( second.Load( error ) );
+    second.BeginAction();
+    assert( second.SetArrayObjectField(
+        "array", "textureName", "brick", "roughnessDefault", "0.6", error ) );
+    assert( second.EndActionAndSave( ValidJsonShape, error ) );
+    assert( Read( backupFile ) == firstBackup );
+
+    // A file created after a missing document was loaded is an external edit.
+    const auto createdLaterPath = root / "created-later.json";
+    LiveEditorDocument createdLater( createdLaterPath, backup );
+    assert( createdLater.Load( error ) );
+    createdLater.BeginAction();
+    assert( createdLater.SetRootField( "newEditorValue", "true", error ) );
+    Write( createdLaterPath, original );
+    assert( !createdLater.EndActionAndSave( ValidJsonShape, error ) );
+    assert( createdLater.HasExternalConflict() );
+    assert( Read( createdLaterPath ) == original );
+
+    std::filesystem::remove_all( root );
+    return 0;
+}
diff --git a/Tests/TextureInheritanceTests.cpp b/Tests/TextureInheritanceTests.cpp
new file mode 100644
index 0000000..52c7d3e
--- /dev/null
+++ b/Tests/TextureInheritanceTests.cpp
@@ -0,0 +1,41 @@
+// Copyright (c) 2026 They Still Hunger contributors
+// SPDX-License-Identifier: MIT
+
+#include "TextureMetaResolve.h"
+
+#include <cassert>
+
+int main()
+{
+    RTGL1::TextureMetaConfig global{};
+    global.forceOpaque = true;
+    global.metallicDefault = 0.25f;
+    global.roughnessDefault = 0.7f;
+    global.attachedLightColor = std::array< uint8_t, 3 >{ 10, 20, 30 };
+
+    RTGL1::TextureMetaConfig map{};
+    map.forceOpaque = false;
+    map.roughnessDefault = 0.1f;
+    map.attachedLightIntensity = 42.0f;
+
+    const RTGL1::TextureMeta effective = RTGL1::ResolveTextureMeta( &global, &map );
+    assert( !effective.forceOpaque );
+    assert( effective.metallicDefault == 0.25f );
+    assert( effective.roughnessDefault == 0.1f );
+    assert( effective.attachedLightIntensity == 42.0f );
+    assert( effective.attachedLightColor == ( std::array< uint8_t, 3 >{ 10, 20, 30 } ) );
+
+    // Unused global fields retain renderer defaults.
+    const RTGL1::TextureMeta defaults = RTGL1::ResolveTextureMeta< RTGL1::TextureMetaConfig >( nullptr );
+    assert( defaults.roughnessDefault == 1.0f );
+    assert( defaults.metallicDefault == 0.0f );
+    assert( !defaults.isMirror );
+
+    RTGL1::TextureMetaConfig merged{};
+    RTGL1::MergeTextureMetaPatch( merged, global );
+    RTGL1::MergeTextureMetaPatch( merged, map );
+    assert( merged.forceOpaque && !*merged.forceOpaque );
+    assert( merged.metallicDefault == 0.25f );
+    assert( merged.roughnessDefault == 0.1f );
+    return 0;
+}
