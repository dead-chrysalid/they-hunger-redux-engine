+std::string RTGL1::LiveEditor::SerializeLights( const std::vector< EditableLight >& values )
+{
+    std::string json = "[\n";
+    for( size_t i = 0; i < values.size(); i++ )
+    {
+        const auto& editable = values[ i ];
+        const auto color = Utils::UnpackColor4DPacked32Components(
+            std::visit( []( const auto& v ) { return v.color; }, editable.value ) );
+        const auto direction = LightDirection( editable.value );
+        const auto position = LightPosition( editable.value, editable.nodePosition );
+        float sourceRadius = 0.05f;
+        float angular = 0.5f;
+        float inner = 0;
+        float outer = 0.7853982f;
+        if( auto point = std::get_if< RgSphericalLightUploadInfo >( &editable.value ) )
+            sourceRadius = point->radius;
+        if( auto spot = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+        {
+            sourceRadius = spot->radius;
+            inner = spot->angleInner;
+            outer = spot->angleOuter;
+        }
+        if( auto sun = std::get_if< RgDirectionalLightUploadInfo >( &editable.value ) )
+            angular = sun->angularDiameterDegrees;
+        const auto& extra = std::visit( []( const auto& v ) -> const RgLightExtraInfo& { return v.extra; }, editable.value );
+        json += "        {\n";
+        json += "            \"rt_editor_id\": " + LiveEditorDocument::Quote( editable.id ) + ",\n";
+        json += "            \"name\": " + LiveEditorDocument::Quote( editable.name ) + ",\n";
+        json += "            \"type\": " + LiveEditorDocument::Quote( LightType( editable.value ) ) + ",\n";
+        json += "            \"position\": " + JsonArray( std::array{ position.data[ 0 ], position.data[ 1 ], position.data[ 2 ] } ) + ",\n";
+        json += "            \"direction\": " + JsonArray( std::array{ direction.data[ 0 ], direction.data[ 1 ], direction.data[ 2 ] } ) + ",\n";
+        json += "            \"color\": " + JsonArray( std::array{ color[ 0 ], color[ 1 ], color[ 2 ] } ) + ",\n";
+        json += "            \"intensity\": " + JsonFloat( std::visit( []( const auto& v ) { return v.intensity; }, editable.value ) ) + ",\n";
+        json += "            \"innerConeAngle\": " + JsonFloat( inner ) + ",\n";
+        json += "            \"outerConeAngle\": " + JsonFloat( outer ) + ",\n";
+        json += "            \"rt_source_radius\": " + JsonFloat( sourceRadius ) + ",\n";
+        json += "            \"rt_angular_diameter_degrees\": " + JsonFloat( angular ) + ",\n";
+        json += "            \"lightstyle\": " + std::to_string( std::clamp( extra.lightstyle, 0, 63 ) ) + ",\n";
+        json += std::string( "            \"isVolumetric\": " ) + ( extra.isVolumetric ? "true" : "false" ) + "\n";
+        json += "        }";
+        if( i + 1 < values.size() ) json += ',';
+        json += '\n';
+    }
+    return json + "    ]";
+}
+
+bool RTGL1::LiveEditor::SaveLights()
+{
+    if( !gltfDocument ) return false;
+    if( !gltfDocument->IsInAction() ) gltfDocument->BeginAction();
+    std::string error;
+    const std::string serialized = SerializeLights( lights );
+    if( !gltfDocument->SetRootObjectField( "extras", "rt_suppress_original_lights", "true", error ) ||
+        !gltfDocument->SetRootObjectField( "extras", "rt_editor_lights", serialized, error ) ||
+        !gltfDocument->EndActionAndSave( ValidateGltf, error ) )
+    {
+        statusMessage = error;
+        hasUnsavedChanges = true;
+        return false;
+    }
+    statusMessage = "Saved light action";
+    return true;
+}
+
+bool RTGL1::LiveEditor::ValidateGltf( const std::filesystem::path& path, std::string& error )
+{
+    cgltf_options options{};
+    cgltf_data* data{};
+    const auto result = cgltf_parse_file( &options, path.string().c_str(), &data );
+    if( data ) cgltf_free( data );
+    if( result != cgltf_result_success )
+    {
+        error = "glTF validation parse failed for " + path.string() +
+                " (cgltf result " + std::to_string( int( result ) ) + ")";
+        return false;
+    }
+    return true;
+}
+
+bool RTGL1::LiveEditor::ValidateScenes( const std::filesystem::path& path, std::string& error )
+{
+    if( !json_parser::ReadFileAs< SceneMetaArray >( path ) )
+    {
+        error = "scenes.json validation failed: " + path.string();
+        return false;
+    }
+    return true;
+}
+
+bool RTGL1::LiveEditor::ValidateTextures( const std::filesystem::path& path, std::string& error )
+{
+    if( !json_parser::ReadFileAs< TextureMetaArray >( path ) )
+    {
+        error = "textures.json validation failed: " + path.string();
+        return false;
+    }
+    return true;
+}
+
+void RTGL1::LiveEditor::RetrySave()
+{
+    std::string error;
+    bool ok = true;
+    if( scenesDocument && scenesDocument->IsDirty() )
+        ok &= scenesDocument->RetrySave( ValidateScenes, error );
+    if( globalTexturesDocument && globalTexturesDocument->IsDirty() )
+        ok &= globalTexturesDocument->RetrySave( ValidateTextures, error );
+    if( sceneTexturesDocument && sceneTexturesDocument->IsDirty() )
+        ok &= sceneTexturesDocument->RetrySave( ValidateTextures, error );
+    if( gltfDocument && gltfDocument->IsDirty() )
+        ok &= gltfDocument->RetrySave( ValidateGltf, error );
+    statusMessage = ok ? "All pending editor files saved" : error;
+}
