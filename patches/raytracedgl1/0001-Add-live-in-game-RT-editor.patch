+    F( forceExactNormals ) F( isMirror ) F( isWater ) F( isWaterIfTranslucent ) \
+    F( isGlass ) F( isGlassIfTranslucent ) F( isAcid ) F( isGlassIfSmooth ) \
+    F( isMirrorIfSmooth ) F( isThinMedia ) F( metallicDefault ) F( roughnessDefault ) \
+    F( emissiveMult ) F( attachedLightIntensity ) F( attachedLightColor ) \
+    F( attachedLightEvenOnDynamic )
+
+inline void ApplyTextureMetaPatch( TextureMeta& dst, const TextureMetaConfig& src )
+{
+#define APPLY_FIELD( name ) if( src.name ) dst.name = *src.name;
+    RT_TEXTURE_META_OPTIONAL_FIELDS( APPLY_FIELD )
+#undef APPLY_FIELD
+}
+
+inline void MergeTextureMetaPatch( TextureMetaConfig& dst, const TextureMetaConfig& src )
+{
+#define MERGE_FIELD( name ) if( src.name ) dst.name = src.name;
+    RT_TEXTURE_META_OPTIONAL_FIELDS( MERGE_FIELD )
+#undef MERGE_FIELD
+}
+
+inline size_t CountConfiguredTextureFields( const TextureMetaConfig& src )
+{
+    size_t count = 0;
+#define COUNT_FIELD( name ) if( src.name ) ++count;
+    RT_TEXTURE_META_OPTIONAL_FIELDS( COUNT_FIELD )
+#undef COUNT_FIELD
+    return count;
+}
+
+template< typename... Patches >
+TextureMeta ResolveTextureMeta( const Patches*... patches )
+{
+    TextureMeta result{};
+    ( ( patches ? ApplyTextureMetaPatch( result, *patches ) : void() ), ... );
+    return result;
+}
+}
