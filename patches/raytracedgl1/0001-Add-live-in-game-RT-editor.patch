+// Developer live editor. The host owns input capture and forwards normalized events here.
+typedef enum RgEditorInputType
+{
+    RG_EDITOR_INPUT_NONE = 0,
+    RG_EDITOR_INPUT_KEY,
+    RG_EDITOR_INPUT_TEXT,
+    RG_EDITOR_INPUT_MOUSE_MOVE,
+    RG_EDITOR_INPUT_MOUSE_BUTTON,
+    RG_EDITOR_INPUT_MOUSE_WHEEL,
+} RgEditorInputType;
+
+typedef struct RgEditorInputEvent
+{
+    RgEditorInputType type;
+    int32_t           key;
+    RgBool32          down;
+    int32_t           button;
+    uint32_t          modifiers;
+    float             x;
+    float             y;
+    float             dx;
+    float             dy;
+    float             wheel;
+    char              text[ 32 ];
+} RgEditorInputEvent;
+
+typedef struct RgEditorStatus
+{
+    RgBool32 available;
+    RgBool32 active;
+    RgBool32 workspaceOpen;
+    RgBool32 wantsInput;
+    RgBool32 wantsCursor;
+    RgBool32 hasUnsavedChanges;
+    uint32_t mapSerial;
+    char     mapName[ 64 ];
+    char     message[ 256 ];
+} RgEditorStatus;
+
+RGAPI RgResult RGCONV rgEditorSetEnabled( RgInstance instance, RgBool32 enabled );
