+void RTGL1::LiveEditor::DrawReticleAndGlyphs( const RgDrawFrameInfo& drawInfo )
+{
+    ImGuiIO& io = ImGui::GetIO();
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    const ImVec2 center{ io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f };
+    if( !workspaceOpen )
+    {
+        draw->AddLine( { center.x - 7, center.y }, { center.x + 7, center.y }, 0xFFFFFFFF, 1.5f );
+        draw->AddLine( { center.x, center.y - 7 }, { center.x, center.y + 7 }, 0xFFFFFFFF, 1.5f );
+    }
+    float inv[ 16 ];
+    Matrix::Inverse( inv, drawInfo.view );
+    RgFloat3D camera{ inv[ 12 ], inv[ 13 ], inv[ 14 ] };
+    for( size_t i = 0; i < lights.size(); i++ )
+    {
+        RgFloat3D point = LightPosition( lights[ i ].value, lights[ i ].nodePosition );
+        if( std::holds_alternative< RgDirectionalLightUploadInfo >( lights[ i ].value ) )
+        {
+            auto d = LightDirection( lights[ i ].value );
+            point = { camera.data[ 0 ] - d.data[ 0 ] * 128.0f,
+                      camera.data[ 1 ] - d.data[ 1 ] * 128.0f,
+                      camera.data[ 2 ] - d.data[ 2 ] * 128.0f };
+        }
+        ImVec2 screen;
+        if( Project( drawInfo.view,
+                     drawInfo.fovYRadians,
+                     io.DisplaySize.x,
+                     io.DisplaySize.y,
+                     point,
+                     screen ) )
+        {
+            const bool selected = selectedLight == static_cast< int >( i );
+            const auto colorBytes = Utils::UnpackColor4DPacked32Components(
+                std::visit( []( const auto& value ) { return value.color; }, lights[ i ].value ) );
+            const ImU32 lightColor =
+                IM_COL32( colorBytes[ 0 ], colorBytes[ 1 ], colorBytes[ 2 ], 255 );
+            const ImU32 haloColor = selected ? IM_COL32( 255, 255, 255, 255 )
+                                              : IM_COL32( 255, 176, 48, 220 );
+            draw->AddCircleFilled( screen, 6.0f, lightColor );
+            draw->AddCircle( screen, selected ? 11.0f : 10.0f, haloColor, 16, selected ? 2.5f : 2.0f );
+        }
+
+        if( selectedLight == static_cast< int >( i ) )
+        {
+            if( const auto* spot =
+                    std::get_if< RgSpotLightUploadInfo >( &lights[ i ].value ) )
+            {
+                const auto colorBytes = Utils::UnpackColor4DPacked32Components( spot->color );
+                DrawProjectedSpotCone( draw,
+                                       drawInfo,
+                                       io.DisplaySize,
+                                       *spot,
+                                       spot->angleOuter,
+                                       96.0f,
+                                       IM_COL32( colorBytes[ 0 ],
+                                                 colorBytes[ 1 ],
+                                                 colorBytes[ 2 ],
+                                                 230 ),
+                                       true,
+                                       2.0f );
+                DrawProjectedSpotCone( draw,
+                                       drawInfo,
+                                       io.DisplaySize,
+                                       *spot,
+                                       spot->angleInner,
+                                       96.0f,
+                                       IM_COL32( colorBytes[ 0 ],
+                                                 colorBytes[ 1 ],
+                                                 colorBytes[ 2 ],
+                                                 150 ),
+                                       false,
+                                       1.25f );
+            }
+        }
+    }
+}
