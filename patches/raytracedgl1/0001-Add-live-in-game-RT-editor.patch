+std::string JsonFloat( float value )
+{
+    char buffer[ 64 ];
+    auto [ end, ec ] = std::to_chars( buffer, std::end( buffer ), value );
+    if( ec != std::errc{} )
+    {
+        return "0";
+    }
+    return std::string( buffer, end );
+}
+
+template< typename T, size_t N >
+std::string JsonArray( const std::array< T, N >& values )
+{
+    std::string result = "[";
+    for( size_t i = 0; i < N; i++ )
+    {
+        if( i )
+        {
+            result += ", ";
+        }
+        if constexpr( std::is_floating_point_v< T > )
+        {
+            result += JsonFloat( values[ i ] );
+        }
+        else
+        {
+            result += std::to_string( values[ i ] );
+        }
+    }
+    return result + "]";
+}
+
+RgFloat3D LightPosition( const RTGL1::GenericLight& light, const RgFloat3D& nodePosition )
+{
+    return std::visit(
+        [ & ]( const auto& value ) -> RgFloat3D {
+            using T = std::decay_t< decltype( value ) >;
+            if constexpr( std::is_same_v< T, RgSphericalLightUploadInfo > ||
+                          std::is_same_v< T, RgSpotLightUploadInfo > )
+            {
+                return value.position;
+            }
+            return nodePosition;
+        },
+        light );
+}
+
+RgFloat3D LightDirection( const RTGL1::GenericLight& light )
+{
+    return std::visit(
+        []( const auto& value ) -> RgFloat3D {
+            using T = std::decay_t< decltype( value ) >;
+            if constexpr( std::is_same_v< T, RgDirectionalLightUploadInfo > ||
+                          std::is_same_v< T, RgSpotLightUploadInfo > )
+            {
+                return value.direction;
+            }
+            return { 0, 0, -1 };
+        },
+        light );
+}
+
+uint64_t LightId( const RTGL1::GenericLight& light )
+{
