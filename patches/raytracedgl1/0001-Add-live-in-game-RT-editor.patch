+        {
+            while( i < input.size() && std::isspace( static_cast< unsigned char >( input[ i ] ) ) )
+                ++i;
+
+            if( i + 1 < input.size() && input[ i ] == '/' && input[ i + 1 ] == '/' )
+            {
+                i += 2;
+                while( i < input.size() && input[ i ] != '\n' )
+                    ++i;
+                continue;
+            }
+            if( i + 1 < input.size() && input[ i ] == '/' && input[ i + 1 ] == '*' )
+            {
+                i += 2;
+                while( i + 1 < input.size() && !( input[ i ] == '*' && input[ i + 1 ] == '/' ) )
+                    ++i;
+                i = std::min( i + 2, input.size() );
+                continue;
+            }
+            break;
+        }
+    }
