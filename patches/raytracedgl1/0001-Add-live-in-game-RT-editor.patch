 {
+// The pinned Glaze version can propagate an enclosing array's whitespace state
+// into object members. It then rejects otherwise valid whitespace (or JSONC
+// comments) between ':' and a member value. Normalize only the in-memory parse
+// copy; the token-aware editor document still preserves the original bytes.
+std::string NormalizeObjectValueSpacing( std::string_view input )
+{
+    std::string result;
+    result.reserve( input.size() );
+    bool inString = false;
+    bool escaped = false;
+    bool inLineComment = false;
+    bool inBlockComment = false;
+
+    for( size_t i = 0; i < input.size(); )
+    {
+        const char c = input[ i ];
+        result.push_back( c );
+        ++i;
+
+        if( inLineComment )
+        {
+            inLineComment = c != '\n';
+            continue;
+        }
+        if( inBlockComment )
+        {
+            if( c == '*' && i < input.size() && input[ i ] == '/' )
+            {
+                result.push_back( input[ i++ ] );
+                inBlockComment = false;
+            }
+            continue;
+        }
+        if( inString )
+        {
+            if( escaped )
+                escaped = false;
+            else if( c == '\\' )
+                escaped = true;
+            else if( c == '"' )
+                inString = false;
+            continue;
+        }
+
+        if( c == '"' )
+        {
+            inString = true;
+            continue;
+        }
+        if( c == '/' && i < input.size() && input[ i ] == '/' )
+        {
+            result.push_back( input[ i++ ] );
+            inLineComment = true;
+            continue;
+        }
