+bool RTGL1::LiveEditor::SaveTextureField( std::string_view texture,
+                                          bool perScene,
+                                          std::string_view field,
+                                          std::optional< std::string_view > value )
+{
+    LiveEditorDocument* document =
+        perScene ? sceneTexturesDocument.get() : globalTexturesDocument.get();
+    if( !document ) return false;
+    if( !document->IsInAction() ) document->BeginAction();
+    std::string error;
+    if( !document->SetArrayObjectField(
+            "array", "textureName", texture, field, value, error ) ||
+        !document->EndActionAndSave( ValidateTextures, error ) )
+    {
+        statusMessage = error;
+        hasUnsavedChanges = true;
+        return false;
+    }
+    statusMessage = "Saved texture action";
+    return true;
+}
+
+void RTGL1::LiveEditor::DrawTexturePanel( TextureMetaManager& manager,
+                                          TextureManager& textures,
+                                          SceneImportExport& sceneImportExport )
+{
+    ImGui::InputTextWithHint( "Search", "texture name", textureSearch, std::size( textureSearch ) );
+    ImGui::Checkbox( "Per-map override", &texturePerScene );
+    if( ImGui::IsItemHovered() )
+        ImGui::SetTooltip( "Used per-map fields override global fields; unused fields inherit." );
+
+    std::vector< std::string > names = textures.GetMaterialNames();
+    const std::vector< std::string > loadedNames = names;
+    for( const std::string& configured : manager.GetConfiguredTextureNames() )
+    {
+        if( std::ranges::find( names, configured ) == names.end() ) names.push_back( configured );
+    }
+    std::ranges::sort( names );
+    ImGui::BeginChild( "TextureBrowser", ImVec2( 0, 180 ), true );
+    for( const std::string& name : names )
+    {
+        if( textureSearch[ 0 ] && name.find( textureSearch ) == std::string::npos ) continue;
+        if( ImGui::Selectable( name.c_str(), selectedTexture == name ) )
+        {
+            selectedTexture = name;
+            textureEdit = manager.AccessConfig( name, texturePerScene ).value_or( TextureMetaConfig{} );
+            textureEdit.textureName = name;
+            textureEditPerScene = texturePerScene;
+        }
+    }
+    ImGui::EndChild();
+    if( selectedTexture.empty() )
+    {
+        ImGui::TextDisabled( "Select a texture or point at a surface in flight mode." );
+        return;
+    }
+    if( textureEdit.textureName != selectedTexture || textureEditPerScene != texturePerScene )
+    {
+        textureEdit = manager.AccessConfig( selectedTexture, texturePerScene )
+                          .value_or( TextureMetaConfig{} );
+        textureEdit.textureName = selectedTexture;
+        textureEditPerScene = texturePerScene;
+    }
+    ImGui::Text( "Texture: %s", selectedTexture.c_str() );
+    const TextureMetaConfig globalConfig =
+        manager.AccessConfig( selectedTexture, false ).value_or( TextureMetaConfig{} );
+    const TextureMetaConfig mapConfig =
+        manager.AccessConfig( selectedTexture, true ).value_or( TextureMetaConfig{} );
+    const size_t globalFields = CountConfiguredTextureFields( globalConfig );
+    const size_t mapFields = CountConfiguredTextureFields( mapConfig );
+    ImGui::TextDisabled( "Effective source: %zu map override fields, %zu global fields, then renderer defaults",
+                         mapFields,
+                         globalFields );
+    if( std::ranges::find( loadedNames, selectedTexture ) != loadedNames.end() )
+    {
+        ImGui::Image( reinterpret_cast< ImTextureID >( selectedTexture.data() ), ImVec2( 128, 128 ) );
+        ImGui::SameLine();
+        ImGui::TextWrapped( "Loaded texture preview\nEditing layer: %s",
+                            texturePerScene ? "current map" : "global" );
+    }
+    else
+    {
+        ImGui::TextDisabled( "Configured but not currently loaded; no thumbnail is available." );
+    }
+
+    LiveEditorDocument* activeTextureDocument =
+        texturePerScene ? sceneTexturesDocument.get() : globalTexturesDocument.get();
+    if( activeTextureDocument )
+    {
+        std::string error;
+        auto refreshTextureEditor = [ & ] {
+            manager.ClearLiveOverrides();
+            manager.RereadFromFiles( std::string_view( currentMap ) );
+            textureEdit = manager.AccessConfig( selectedTexture, texturePerScene )
+                              .value_or( TextureMetaConfig{} );
+            textureEdit.textureName = selectedTexture;
+            textureEditPerScene = texturePerScene;
+            sceneImportExport.RequestReimport();
+        };
+        ImGui::BeginDisabled( !activeTextureDocument->CanUndo() );
+        if( ImGui::Button( "Undo texture" ) )
+        {
+            if( activeTextureDocument->Undo( ValidateTextures, error ) )
+            {
+                refreshTextureEditor();
+                statusMessage = "Undid texture action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !activeTextureDocument->CanRedo() );
+        if( ImGui::Button( "Redo texture" ) )
+        {
+            if( activeTextureDocument->Redo( ValidateTextures, error ) )
+            {
+                refreshTextureEditor();
+                statusMessage = "Redid texture action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+    }
+
+    auto saveLive = [ & ]( const char* field, std::optional< std::string_view > json ) {
+        manager.SetLiveOverride( selectedTexture, textureEdit, texturePerScene );
+        SaveTextureField( selectedTexture, texturePerScene, field, json );
+        sceneImportExport.RequestReimport();
+    };
+    auto optionalBool = [ & ]( const char* label, const char* field, std::optional< bool >& value ) {
+        int state = value ? ( *value ? 2 : 1 ) : 0;
+        const char* states[] = { "Unused (inherit)", "False", "True" };
+        ImGui::PushID( field );
+        if( ImGui::Combo( label, &state, states, 3 ) )
+        {
+            value = state == 0 ? std::nullopt : std::optional< bool >( state == 2 );
+            const char* literal = state == 2 ? "true" : "false";
+            saveLive( field,
+                      value ? std::optional< std::string_view >( literal ) : std::nullopt );
+        }
+        ImGui::PopID();
+    };
+    auto optionalFloat = [ & ]( const char* label,
+                                const char* field,
+                                std::optional< float >& value,
+                                float defaultValue,
+                                float minimum,
+                                float maximum ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional< float >( defaultValue ) : std::nullopt;
+            const std::string json = value ? JsonFloat( *value ) : std::string{};
+            saveLive( field, value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        float edit = value.value_or( defaultValue );
+        if( ImGui::DragFloat( label, &edit, 0.01f, minimum, maximum ) )
+        {
+            LiveEditorDocument* doc = texturePerScene ? sceneTexturesDocument.get()
+                                                      : globalTexturesDocument.get();
+            if( ImGui::IsItemActivated() && doc ) doc->BeginAction();
+            value = std::clamp( edit, minimum, maximum );
+            manager.SetLiveOverride( selectedTexture, textureEdit, texturePerScene );
+            sceneImportExport.RequestReimport();
+        }
+        if( ImGui::IsItemDeactivatedAfterEdit() && value )
+        {
+            const std::string json = JsonFloat( *value );
+            saveLive( field, json );
+        }
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+
+    if( ImGui::CollapsingHeader( "Visibility and alpha", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        optionalBool( "Ignore", "forceIgnore", textureEdit.forceIgnore );
+        optionalBool( "Ignore when rasterized", "forceIgnoreIfRasterized", textureEdit.forceIgnoreIfRasterized );
+        optionalBool( "Force alpha test", "forceAlphaTest", textureEdit.forceAlphaTest );
+        optionalBool( "Force translucent", "forceTranslucent", textureEdit.forceTranslucent );
+        optionalBool( "Force opaque", "forceOpaque", textureEdit.forceOpaque );
+    }
+    if( ImGui::CollapsingHeader( "Normals and material", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        optionalBool( "Generate normals", "forceGenerateNormals", textureEdit.forceGenerateNormals );
+        optionalBool( "Exact normals", "forceExactNormals", textureEdit.forceExactNormals );
+        optionalFloat( "Metallic", "metallicDefault", textureEdit.metallicDefault, 0.0f, 0.0f, 1.0f );
+        optionalFloat( "Roughness", "roughnessDefault", textureEdit.roughnessDefault, 1.0f, 0.0f, 1.0f );
+        optionalFloat( "Emissive", "emissiveMult", textureEdit.emissiveMult, 0.0f, 0.0f, 1.0f );
+    }
+    if( ImGui::CollapsingHeader( "Surface classification", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        ImGui::TextWrapped( "Water, glass, mirror, and acid are mutually exclusive at runtime; direct classifications take precedence over smoothness rules." );
+        optionalBool( "Mirror", "isMirror", textureEdit.isMirror );
+        optionalBool( "Water", "isWater", textureEdit.isWater );
+        optionalBool( "Water if translucent", "isWaterIfTranslucent", textureEdit.isWaterIfTranslucent );
+        optionalBool( "Glass", "isGlass", textureEdit.isGlass );
+        optionalBool( "Glass if translucent", "isGlassIfTranslucent", textureEdit.isGlassIfTranslucent );
+        optionalBool( "Acid", "isAcid", textureEdit.isAcid );
+        optionalBool( "Glass if smooth", "isGlassIfSmooth", textureEdit.isGlassIfSmooth );
+        optionalBool( "Mirror if smooth", "isMirrorIfSmooth", textureEdit.isMirrorIfSmooth );
+        optionalBool( "Thin media", "isThinMedia", textureEdit.isThinMedia );
+    }
+    if( ImGui::CollapsingHeader( "Attached light", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        optionalFloat( "Intensity", "lightIntensity", textureEdit.attachedLightIntensity, 0.0f, 0.0f, 1000000.0f );
+        bool used = textureEdit.attachedLightColor.has_value();
+        if( ImGui::Checkbox( "Use light color", &used ) )
+        {
+            textureEdit.attachedLightColor =
+                used ? std::optional( std::array< uint8_t, 3 >{ 255, 255, 255 } ) : std::nullopt;
+            const std::string json = textureEdit.attachedLightColor
+                                         ? JsonArray( *textureEdit.attachedLightColor )
+                                         : std::string{};
+            saveLive( "lightColor",
+                      textureEdit.attachedLightColor
+                          ? std::optional< std::string_view >( json )
+                          : std::nullopt );
+        }
+        if( textureEdit.attachedLightColor )
+        {
+            float color[ 3 ] = { ( *textureEdit.attachedLightColor )[ 0 ] / 255.0f,
+                                 ( *textureEdit.attachedLightColor )[ 1 ] / 255.0f,
+                                 ( *textureEdit.attachedLightColor )[ 2 ] / 255.0f };
+            if( ImGui::ColorEdit3( "Light color", color ) )
+            {
+                LiveEditorDocument* doc = texturePerScene ? sceneTexturesDocument.get()
+                                                          : globalTexturesDocument.get();
+                if( ImGui::IsItemActivated() && doc ) doc->BeginAction();
+                textureEdit.attachedLightColor = std::array< uint8_t, 3 >{
+                    uint8_t( std::clamp( color[ 0 ], 0.0f, 1.0f ) * 255 ),
+                    uint8_t( std::clamp( color[ 1 ], 0.0f, 1.0f ) * 255 ),
+                    uint8_t( std::clamp( color[ 2 ], 0.0f, 1.0f ) * 255 ),
+                };
+                manager.SetLiveOverride( selectedTexture, textureEdit, texturePerScene );
+            }
+            if( ImGui::IsItemDeactivatedAfterEdit() )
+            {
+                const std::string json = JsonArray( *textureEdit.attachedLightColor );
+                saveLive( "lightColor", json );
+            }
+        }
+        optionalBool( "Light on dynamic models", "lightEvenOnDynamic", textureEdit.attachedLightEvenOnDynamic );
+        if( selectedSurface.valid && selectedSurface.textureName == selectedTexture &&
+            ImGui::Button( "Create punctual light here" ) )
+        {
+            lightUndo.push_back( lights );
+            lightRedo.clear();
+            const uint64_t id = NewLightId();
+            lights.push_back( { .id = std::to_string( id ),
+                                .name = selectedTexture + " light",
+                                .value = MakeLight( 0,
+                                                    id,
+                                                    selectedSurface.hitPosition,
+                                                    { 0, 0, -1 },
+                                                    0xFFFFFFFF,
+                                                    500.0f,
+                                                    { .exists = true } ),
+                                .nodePosition = selectedSurface.hitPosition } );
+            selectedLight = static_cast< int >( lights.size() ) - 1;
+            if( gltfDocument ) gltfDocument->BeginAction();
+            // Scene is updated at the beginning of the next frame; saving is immediate.
+            SaveLights();
+        }
+    }
+}
