+namespace
+{
+using Range = std::pair< size_t, size_t >;
+
+size_t SkipString( std::string_view s, size_t at )
+{
+    const char quote = s[ at++ ];
+    while( at < s.size() )
+    {
+        if( s[ at ] == '\\' )
+        {
+            at += std::min< size_t >( 2, s.size() - at );
+        }
+        else if( s[ at++ ] == quote )
+        {
+            break;
+        }
+    }
+    return at;
+}
+
+size_t SkipTrivia( std::string_view s, size_t at )
+{
+    for( ;; )
+    {
+        while( at < s.size() && std::isspace( static_cast< unsigned char >( s[ at ] ) ) )
+        {
+            at++;
+        }
+        if( at + 1 < s.size() && s[ at ] == '/' && s[ at + 1 ] == '/' )
+        {
+            at += 2;
+            while( at < s.size() && s[ at ] != '\n' )
+            {
+                at++;
+            }
+            continue;
+        }
+        if( at + 1 < s.size() && s[ at ] == '/' && s[ at + 1 ] == '*' )
+        {
+            at += 2;
+            while( at + 1 < s.size() && !( s[ at ] == '*' && s[ at + 1 ] == '/' ) )
+            {
+                at++;
+            }
+            at = std::min( at + 2, s.size() );
+            continue;
+        }
+        return at;
+    }
+}
+
+std::optional< size_t > Matching( std::string_view s, size_t open )
+{
+    if( open >= s.size() || ( s[ open ] != '{' && s[ open ] != '[' ) )
+    {
+        return std::nullopt;
+    }
+    const char opening = s[ open ];
+    const char closing = opening == '{' ? '}' : ']';
+    int        depth   = 1;
+    for( size_t i = open + 1; i < s.size(); )
+    {
+        if( s[ i ] == '"' || s[ i ] == '\'' )
+        {
+            i = SkipString( s, i );
+            continue;
+        }
+        if( i + 1 < s.size() && s[ i ] == '/' && ( s[ i + 1 ] == '/' || s[ i + 1 ] == '*' ) )
+        {
+            i = SkipTrivia( s, i );
+            continue;
+        }
+        if( s[ i ] == opening )
+        {
+            depth++;
+        }
+        else if( s[ i ] == closing && --depth == 0 )
+        {
+            return i;
+        }
+        i++;
+    }
+    return std::nullopt;
+}
+
+std::optional< Range > Property( std::string_view s,
+                                 size_t           objectBegin,
+                                 size_t           objectEnd,
+                                 std::string_view name )
+{
+    size_t i = objectBegin + 1;
+    while( i < objectEnd )
+    {
+        i = SkipTrivia( s, i );
+        if( i >= objectEnd || s[ i ] == '}' )
+        {
+            break;
+        }
+        if( s[ i ] != '"' )
+        {
+            i++;
+            continue;
+        }
+        const size_t keyBegin = i;
+        const size_t keyEnd   = SkipString( s, i );
+        const auto   key      = s.substr( keyBegin + 1, keyEnd - keyBegin - 2 );
+        i                     = SkipTrivia( s, keyEnd );
+        if( i >= objectEnd || s[ i ] != ':' )
+        {
+            continue;
+        }
+        const size_t valueBegin = SkipTrivia( s, i + 1 );
+        size_t       valueEnd   = valueBegin;
+        if( valueBegin < objectEnd && ( s[ valueBegin ] == '{' || s[ valueBegin ] == '[' ) )
+        {
+            auto close = Matching( s, valueBegin );
+            if( !close )
+            {
+                return std::nullopt;
+            }
+            valueEnd = *close + 1;
+        }
+        else if( valueBegin < objectEnd && ( s[ valueBegin ] == '"' || s[ valueBegin ] == '\'' ) )
+        {
+            valueEnd = SkipString( s, valueBegin );
+        }
+        else
+        {
+            while( valueEnd < objectEnd && s[ valueEnd ] != ',' && s[ valueEnd ] != '}' &&
+                   s[ valueEnd ] != '\n' && s[ valueEnd ] != '\r' )
+            {
+                valueEnd++;
+            }
+            while( valueEnd > valueBegin &&
+                   std::isspace( static_cast< unsigned char >( s[ valueEnd - 1 ] ) ) )
+            {
+                valueEnd--;
+            }
+        }
+        if( key == name )
+        {
+            return Range{ keyBegin, valueEnd };
+        }
+        i = valueEnd;
+        while( i < objectEnd && s[ i ] != ',' && s[ i ] != '}' )
+        {
+            i++;
+        }
+        if( i < objectEnd && s[ i ] == ',' )
+        {
+            i++;
+        }
+    }
+    return std::nullopt;
+}
+
+std::optional< Range > PropertyValue( std::string_view s, const Range& property )
+{
+    size_t colon = s.find( ':', property.first );
+    if( colon == std::string_view::npos || colon >= property.second )
+    {
+        return std::nullopt;
+    }
+    return Range{ SkipTrivia( s, colon + 1 ), property.second };
+}
+
+std::optional< Range > RootObject( std::string_view s )
+{
+    size_t open = SkipTrivia( s, 0 );
+    if( open >= s.size() || s[ open ] != '{' )
+    {
+        return std::nullopt;
+    }
+    if( auto close = Matching( s, open ) )
+    {
+        return Range{ open, *close };
+    }
+    return std::nullopt;
+}
+
+std::optional< Range > ArrayObjectWithKey( std::string_view s,
+                                           const Range&     array,
+                                           std::string_view keyField,
+                                           std::string_view key )
+{
+    for( size_t i = array.first + 1; i < array.second; )
+    {
+        i = SkipTrivia( s, i );
+        if( i >= array.second )
+        {
+            break;
+        }
+        if( s[ i ] != '{' )
+        {
+            i++;
+            continue;
+        }
+        auto close = Matching( s, i );
+        if( !close )
+        {
+            return std::nullopt;
+        }
+        Range object{ i, *close };
+        if( auto prop = Property( s, object.first, object.second, keyField ) )
+        {
+            if( auto value = PropertyValue( s, *prop ) )
+            {
+                auto raw = s.substr( value->first, value->second - value->first );
+                if( raw.size() >= 2 && raw.front() == '"' && raw.back() == '"' &&
+                    raw.substr( 1, raw.size() - 2 ) == key )
+                {
+                    return object;
+                }
+            }
+        }
+        i = *close + 1;
+    }
+    return std::nullopt;
+}
+
+std::string IndentAt( std::string_view s, size_t at )
+{
+    size_t line = s.rfind( '\n', at );
+    line        = line == std::string_view::npos ? 0 : line + 1;
+    size_t end  = line;
+    while( end < s.size() && ( s[ end ] == ' ' || s[ end ] == '\t' ) )
+    {
+        end++;
+    }
+    return std::string( s.substr( line, end - line ) );
+}
+
+bool SetObjectProperty( std::string&                     text,
+                        const Range&                     object,
+                        std::string_view                 field,
+                        std::optional< std::string_view > value,
+                        std::string&                     error )
+{
+    if( auto existing = Property( text, object.first, object.second, field ) )
+    {
+        if( value )
+        {
+            auto valueRange = PropertyValue( text, *existing );
+            if( !valueRange )
+            {
+                error = "Could not locate the existing JSON value";
+                return false;
+            }
+            text.replace( valueRange->first, valueRange->second - valueRange->first, *value );
+            return true;
+        }
+
+        size_t eraseBegin = existing->first;
+        size_t eraseEnd   = existing->second;
+        size_t after      = SkipTrivia( text, eraseEnd );
+        if( after < object.second && text[ after ] == ',' )
+        {
+            eraseEnd = after + 1;
+        }
+        else
+        {
+            size_t before = eraseBegin;
+            while( before > object.first + 1 &&
+                   std::isspace( static_cast< unsigned char >( text[ before - 1 ] ) ) )
+            {
+                before--;
+            }
+            if( before > object.first + 1 && text[ before - 1 ] == ',' )
+            {
+                eraseBegin = before - 1;
+            }
+        }
+        text.erase( eraseBegin, eraseEnd - eraseBegin );
+        return true;
+    }
+
+    if( !value )
+    {
+        return true;
+    }
+
+    const std::string baseIndent = IndentAt( text, object.first );
+    const std::string indent     = baseIndent + "    ";
+    const size_t      firstToken = SkipTrivia( text, object.first + 1 );
+    const bool        empty      = firstToken >= object.second;
+    std::string       insertion;
+    if( empty )
+    {
+        insertion = "\n" + indent + RTGL1::LiveEditorDocument::Quote( field ) + ": " +
+                    std::string( *value ) + "\n" + baseIndent;
+    }
+    else
+    {
+        insertion = ",\n" + indent + RTGL1::LiveEditorDocument::Quote( field ) + ": " +
+                    std::string( *value );
+    }
+    text.insert( object.second, insertion );
+    return true;
+}
+} // namespace
+
+RTGL1::LiveEditorDocument::LiveEditorDocument( std::filesystem::path _path,
+                                               std::filesystem::path _backupRoot )
+    : path( std::move( _path ) ), backupRoot( std::move( _backupRoot ) )
+{
+}
+
+std::string RTGL1::LiveEditorDocument::Quote( std::string_view value )
+{
+    std::string result{ "\"" };
+    for( char c : value )
+    {
+        if( c == '\\' || c == '"' )
+        {
+            result.push_back( '\\' );
+        }
+        result.push_back( c );
+    }
+    result.push_back( '"' );
+    return result;
+}
+
+bool RTGL1::LiveEditorDocument::Load( std::string& error )
+{
+    std::ifstream file( path, std::ios::binary );
+    if( !file )
+    {
+        std::error_code existsError;
+        if( !std::filesystem::exists( path, existsError ) && !existsError )
+        {
+            text = "{\n    \"version\": 0,\n    \"array\": []\n}\n";
+            hasDiskWriteTime = false;
+            diskExisted = false;
+            diskSize = 0;
+            dirty = externalConflict = inAction = false;
+            undo.clear();
+            redo.clear();
+            lastError.clear();
+            return true;
+        }
+        error = "Unable to open " + path.string();
+        lastError = error;
+        return false;
+    }
+    std::ostringstream stream;
+    stream << file.rdbuf();
+    text = stream.str();
+    std::error_code ec;
+    diskWriteTime    = std::filesystem::last_write_time( path, ec );
+    hasDiskWriteTime = !ec;
+    ec.clear();
+    diskSize = std::filesystem::file_size( path, ec );
+    if( ec ) diskSize = text.size();
+    diskExisted = true;
+    dirty = externalConflict = inAction = false;
+    undo.clear();
+    redo.clear();
+    lastError.clear();
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::ReloadIfClean( std::string& error, bool* reloaded )
+{
+    if( reloaded ) *reloaded = false;
+    if( dirty || inAction )
+    {
+        externalConflict = CheckExternalChange();
+        return !externalConflict;
+    }
+    if( CheckExternalChange() )
+    {
+        if( !Load( error ) ) return false;
+        if( reloaded ) *reloaded = true;
+    }
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::DiscardAndReload( std::string& error )
+{
+    return Load( error );
+}
+
+void RTGL1::LiveEditorDocument::BeginAction()
+{
+    if( !inAction )
+    {
+        actionStart = text;
+        inAction    = true;
+        actionStartedDirty = dirty;
+    }
+}
+
+void RTGL1::LiveEditorDocument::CancelAction()
+{
+    if( inAction )
+    {
+        text     = actionStart;
+        inAction = false;
+        dirty    = actionStartedDirty;
+    }
+}
+
+bool RTGL1::LiveEditorDocument::EndActionAndSave( const Validator& validator,
+                                                  std::string&     error )
+{
+    if( !inAction )
+    {
+        return true;
+    }
+    inAction = false;
+    if( text == actionStart )
+    {
+        dirty = actionStartedDirty;
+        return true;
+    }
+    undo.push_back( std::move( actionStart ) );
+    redo.clear();
+    dirty = true;
+    return Save( validator, error );
+}
+
+bool RTGL1::LiveEditorDocument::Undo( const Validator& validator, std::string& error )
+{
+    if( inAction || undo.empty() )
+    {
+        return false;
+    }
+    redo.push_back( text );
+    text = std::move( undo.back() );
+    undo.pop_back();
+    dirty = true;
+    return Save( validator, error );
+}
+
+bool RTGL1::LiveEditorDocument::Redo( const Validator& validator, std::string& error )
+{
+    if( inAction || redo.empty() )
+    {
+        return false;
+    }
+    undo.push_back( text );
+    text = std::move( redo.back() );
+    redo.pop_back();
+    dirty = true;
+    return Save( validator, error );
+}
+
+bool RTGL1::LiveEditorDocument::RetrySave( const Validator& validator, std::string& error )
+{
+    return dirty && Save( validator, error );
+}
+
+bool RTGL1::LiveEditorDocument::CheckExternalChange()
+{
+    std::error_code ec;
+    const bool exists = std::filesystem::exists( path, ec );
+    if( ec ) return false;
+    if( exists != diskExisted ) return true;
+    if( !exists ) return false;
+    if( !hasDiskWriteTime )
+    {
+        return false;
+    }
+    auto current = std::filesystem::last_write_time( path, ec );
+    if( !ec && current != diskWriteTime ) return true;
+    ec.clear();
+    const uintmax_t currentSize = std::filesystem::file_size( path, ec );
+    return !ec && currentSize != diskSize;
+}
+
+bool RTGL1::LiveEditorDocument::MakeBackup( std::string& error )
+{
+    if( backupMade )
+    {
+        return true;
+    }
+    std::error_code ec;
+    if( !std::filesystem::exists( path, ec ) && !ec )
+    {
+        backupMade = true;
+        return true;
+    }
+    ec.clear();
+    std::filesystem::create_directories( backupRoot, ec );
+    if( ec )
+    {
+        error = "Unable to create editor backup directory: " + ec.message();
+        return false;
+    }
+    std::string parent = path.parent_path().filename().string();
+    auto backup = backupRoot / ( parent + "_" + path.filename().string() + ".bak" );
+    if( std::filesystem::exists( backup, ec ) && !ec )
+    {
+        backupMade = true;
+        return true;
+    }
+    ec.clear();
+    std::filesystem::copy_file( path, backup, std::filesystem::copy_options::none, ec );
+    if( ec )
+    {
+        error = "Unable to create session backup: " + ec.message();
+        return false;
+    }
+    backupMade = true;
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::Save( const Validator& validator, std::string& error )
+{
+    if( CheckExternalChange() )
+    {
+        externalConflict = true;
+        error = "The file changed externally. Reload or cancel the active edit before saving: " +
+                path.string();
+        lastError = error;
+        return false;
+    }
+    if( !MakeBackup( error ) )
+    {
+        lastError = error;
+        return false;
+    }
+
+    {
+        std::error_code ec;
+        std::filesystem::create_directories( path.parent_path(), ec );
+        if( ec )
+        {
+            error = "Unable to create target directory: " + ec.message();
+            lastError = error;
+            return false;
+        }
+    }
+
+    const auto temporary = path.parent_path() / ( path.filename().string() + ".rt-editor.tmp" );
+    {
+        std::ofstream file( temporary, std::ios::binary | std::ios::trunc );
+        if( !file )
+        {
+            error = "Unable to write temporary file: " + temporary.string();
+            lastError = error;
+            return false;
+        }
+        file.write( text.data(), static_cast< std::streamsize >( text.size() ) );
+        file.flush();
+        if( !file )
+        {
+            error = "Unable to flush temporary file: " + temporary.string();
+            lastError = error;
+            return false;
+        }
+    }
+#ifdef _WIN32
+    {
+        HANDLE handle = CreateFileW( temporary.c_str(),
+                                     GENERIC_WRITE,
+                                     FILE_SHARE_READ,
+                                     nullptr,
+                                     OPEN_EXISTING,
+                                     FILE_ATTRIBUTE_NORMAL,
+                                     nullptr );
+        if( handle == INVALID_HANDLE_VALUE || !FlushFileBuffers( handle ) )
+        {
+            const DWORD flushError = GetLastError();
+            if( handle != INVALID_HANDLE_VALUE ) CloseHandle( handle );
+            error = "Unable to flush temporary file to disk (Windows error " +
+                    std::to_string( flushError ) + "): " + temporary.string();
+            lastError = error;
+            return false;
+        }
+        CloseHandle( handle );
+    }
+#endif
+    if( validator && !validator( temporary, error ) )
+    {
+        std::error_code ignored;
+        std::filesystem::remove( temporary, ignored );
+        lastError = error;
+        return false;
+    }
+
+#ifdef _WIN32
+    if( !MoveFileExW( temporary.c_str(),
+                      path.c_str(),
+                      MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH ) )
+    {
+        error = "Atomic replacement failed (Windows error " + std::to_string( GetLastError() ) +
+                "): " + path.string();
+        lastError = error;
+        return false;
+    }
+#else
+    std::error_code ec;
+    std::filesystem::rename( temporary, path, ec );
+    if( ec )
+    {
+        error = "Atomic replacement failed: " + ec.message();
+        lastError = error;
+        return false;
+    }
+#endif
+
+    std::error_code ec;
+    diskWriteTime    = std::filesystem::last_write_time( path, ec );
+    hasDiskWriteTime = !ec;
+    ec.clear();
+    diskSize = std::filesystem::file_size( path, ec );
+    if( ec ) diskSize = text.size();
+    diskExisted = true;
+    dirty = externalConflict = false;
+    lastError.clear();
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::SetArrayObjectField(
+    std::string_view                 arrayField,
+    std::string_view                 keyField,
+    std::string_view                 key,
+    std::string_view                 field,
+    std::optional< std::string_view > jsonValue,
+    std::string&                     error )
+{
+    auto root = RootObject( text );
+    if( !root )
+    {
+        error = "The document has no valid root object";
+        return false;
+    }
+    auto arrayProperty = Property( text, root->first, root->second, arrayField );
+    if( !arrayProperty )
+    {
+        error = "Missing JSON array property: " + std::string( arrayField );
+        return false;
+    }
+    auto arrayValue = PropertyValue( text, *arrayProperty );
+    if( !arrayValue || text[ arrayValue->first ] != '[' )
+    {
+        error = "Property is not an array: " + std::string( arrayField );
+        return false;
+    }
+    auto arrayClose = Matching( text, arrayValue->first );
+    if( !arrayClose )
+    {
+        error = "Unterminated JSON array: " + std::string( arrayField );
+        return false;
+    }
+    Range array{ arrayValue->first, *arrayClose };
+    if( auto object = ArrayObjectWithKey( text, array, keyField, key ) )
+    {
+        return SetObjectProperty( text, *object, field, jsonValue, error );
+    }
+    if( !jsonValue )
+    {
+        return true;
+    }
+
+    const std::string baseIndent = IndentAt( text, array.first );
+    const std::string indent     = baseIndent + "    ";
+    const bool empty = SkipTrivia( text, array.first + 1 ) >= array.second;
+    std::string object = ( empty ? "\n" : ",\n" ) + indent + "{\n" + indent + "    " +
+                         Quote( keyField ) + ": " + Quote( key ) + ",\n" + indent + "    " +
+                         Quote( field ) + ": " + std::string( *jsonValue ) + "\n" + indent +
+                         "}";
+    text.insert( array.second, object );
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::SetRootField( std::string_view                 field,
+                                              std::optional< std::string_view > jsonValue,
+                                              std::string&                     error )
+{
+    auto root = RootObject( text );
+    if( !root )
+    {
+        error = "The document has no valid root object";
+        return false;
+    }
+    return SetObjectProperty( text, *root, field, jsonValue, error );
+}
+
+bool RTGL1::LiveEditorDocument::SetRootObjectField(
+    std::string_view                 objectField,
+    std::string_view                 field,
+    std::optional< std::string_view > jsonValue,
+    std::string&                     error )
+{
+    auto root = RootObject( text );
+    if( !root )
+    {
+        error = "The document has no valid root object";
+        return false;
+    }
+    auto objectProperty = Property( text, root->first, root->second, objectField );
+    if( !objectProperty )
+    {
+        if( !jsonValue ) return true;
+        if( !SetObjectProperty( text, *root, objectField, std::string_view( "{}" ), error ) )
+            return false;
+        root = RootObject( text );
+        objectProperty = root ? Property( text, root->first, root->second, objectField )
+                              : std::nullopt;
+    }
+    if( !objectProperty )
+    {
+        error = "Could not create root object property: " + std::string( objectField );
+        return false;
+    }
+    auto value = PropertyValue( text, *objectProperty );
+    if( !value || value->first >= text.size() || text[ value->first ] != '{' )
+    {
+        error = "Root property is not an object: " + std::string( objectField );
+        return false;
+    }
+    auto close = Matching( text, value->first );
+    if( !close )
+    {
+        error = "Unterminated root object property: " + std::string( objectField );
+        return false;
+    }
+    return SetObjectProperty( text, Range{ value->first, *close }, field, jsonValue, error );
+}
