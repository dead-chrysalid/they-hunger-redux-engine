+
+void RTGL1::Scene::CapturePickPrimitive( const RgMeshInfo&          mesh,
+                                         const RgMeshPrimitiveInfo& primitive,
+                                         bool                       isStatic )
+{
+    if( !editorCaptureEnabled || ( !isStatic && !editorDynamicCaptureThisFrame ) ||
+        primitive.pVertices == nullptr || primitive.vertexCount == 0 )
+    {
+        return;
+    }
+
+    PickPrimitive captured{
+        .uniqueObjectID = mesh.uniqueObjectID,
+        .primitiveIndex = primitive.primitiveIndexInMesh,
+        .meshName = Utils::SafeCstr( mesh.pMeshName ),
+        .primitiveName = Utils::SafeCstr( primitive.pPrimitiveNameInMesh ),
+        .textureName = Utils::SafeCstr( primitive.pTextureName ),
+        .rasterized = false,
+    };
+    captured.positions.reserve( primitive.vertexCount );
+    for( uint32_t i = 0; i < primitive.vertexCount; i++ )
+    {
+        const auto& p = primitive.pVertices[ i ].position;
+        captured.positions.push_back(
+            Utils::ApplyTransform( mesh.transform, RgFloat3D{ p[ 0 ], p[ 1 ], p[ 2 ] } ) );
+    }
+    if( primitive.pIndices && primitive.indexCount > 0 )
+    {
+        captured.indices.assign( primitive.pIndices, primitive.pIndices + primitive.indexCount );
+    }
+    else
+    {
+        captured.indices.resize( primitive.vertexCount );
+        std::iota( captured.indices.begin(), captured.indices.end(), 0u );
+    }
+    ( isStatic ? staticPickPrimitives : dynamicPickPrimitives ).push_back( std::move( captured ) );
 }
 
 
