@@ -6,6 +6,7 @@
 #include <RTGL1/RTGL1.h>
 
 #include <algorithm>
+#include <array>
 #include <cmath>
 #include <cstddef>
 #include <limits>
@@ -67,6 +68,14 @@ inline float IntegerIntensity( float intensity )
     return std::trunc( std::max( 0.0f, intensity ) );
 }
 
+inline std::array< float, 3 > NormalizeCrosstalk( std::array< float, 3 > value )
+{
+    for( float& channel : value ) channel = std::clamp( channel, 0.001f, 1.0f );
+    const float peak = std::max( { value[ 0 ], value[ 1 ], value[ 2 ] } );
+    for( float& channel : value ) channel /= peak;
+    return value;
+}
