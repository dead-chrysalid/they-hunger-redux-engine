@@ -87,6 +87,43 @@ int main( int argc, char** argv )
     if( !regressionPassed )
         return 1;
 
+    const auto scenesPath = std::filesystem::temp_directory_path() /
+                            ( "rtgl-editor-scenes-parser-" + std::to_string( stamp ) + ".json" );
+    {
+        std::ofstream file( scenesPath, std::ios::binary | std::ios::trunc );
+        file << R"({
+  "version": 0,
+  "array": [
+    {
+      "sceneName":"tone_test",
+      "tonemapDisableEyeAdaptation": true,
+      "tonemapEv100Min": 1.5,
+      "tonemapEv100Max": 8.25,
+      "tonemapWhitePoint": 12,
+      "tonemapSaturation": [-0.1, 0, 0.2],
+      "tonemapCrosstalk": [0.75, 1, 1],
+      "bloomIntensity": 0.8,
+      "bloomInputThreshold": 3,
+      "bloomEmissionMultiplier": 20,
+      "bloomLensDirtIntensity": 1.5
+    }
+  ]
+})";
+    }
+    const auto scenes = RTGL1::json_parser::ReadFileAs< RTGL1::SceneMetaArray >( scenesPath );
+    std::filesystem::remove( scenesPath, ignored );
+    if( !scenes || scenes->array.size() != 1 )
+        return 1;
