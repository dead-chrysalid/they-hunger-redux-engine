 {
     auto live = liveData.find( std::string( sceneName ) );
     auto iter = data.find( std::string( sceneName ) );
@@ -82,6 +85,58 @@ void RTGL1::SceneMetaManager::Modify( std::string_view             sceneName,
         volumetric.allowTintUnderwater = true;
         volumetric.underwaterColor     = { RG_ACCESS_VEC3( *m.volumeUnderwaterColor ) };
     }
+
+    if( m.tonemapDisableEyeAdaptation )
+    {
+        tonemapping.disableEyeAdaptation = *m.tonemapDisableEyeAdaptation;
+    }
+    if( m.tonemapEv100Min )
+    {
+        tonemapping.ev100Min = std::clamp( *m.tonemapEv100Min, -3.0f, 16.0f );
+    }
+    if( m.tonemapEv100Max )
+    {
+        tonemapping.ev100Max = std::clamp( *m.tonemapEv100Max, -3.0f, 16.0f );
+    }
+    if( tonemapping.ev100Min > tonemapping.ev100Max )
+    {
+        std::swap( tonemapping.ev100Min, tonemapping.ev100Max );
+    }
+    if( m.tonemapWhitePoint )
+    {
+        tonemapping.luminanceWhitePoint =
+            std::clamp( *m.tonemapWhitePoint, 0.01f, 1000.0f );
+    }
+    if( m.tonemapSaturation )
+    {
+        auto value = *m.tonemapSaturation;
+        for( float& channel : value ) channel = std::clamp( channel, -1.0f, 1.0f );
+        tonemapping.saturation = { RG_ACCESS_VEC3( value ) };
+    }
+    if( m.tonemapCrosstalk )
+    {
+        const auto value = live_editor_logic::NormalizeCrosstalk( *m.tonemapCrosstalk );
+        tonemapping.crosstalk = { RG_ACCESS_VEC3( value ) };
+    }
+
+    if( m.bloomIntensity )
+    {
+        bloom.bloomIntensity = std::clamp( *m.bloomIntensity, 0.0f, 10.0f );
+    }
+    if( m.bloomInputThreshold )
+    {
+        bloom.inputThreshold = std::clamp( *m.bloomInputThreshold, 0.0f, 100.0f );
+    }
+    if( m.bloomEmissionMultiplier )
+    {
+        bloom.bloomEmissionMultiplier =
+            std::clamp( *m.bloomEmissionMultiplier, 0.0f, 1000.0f );
+    }
+    if( m.bloomLensDirtIntensity )
+    {
+        bloom.lensDirtIntensity =
+            std::clamp( *m.bloomLensDirtIntensity, 0.0f, 10.0f );
+    }
 }
 
