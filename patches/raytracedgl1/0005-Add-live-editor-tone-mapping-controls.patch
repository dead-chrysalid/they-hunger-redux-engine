+void RTGL1::LiveEditor::DrawTonemappingPanel( const RgDrawFrameInfo& drawInfo,
+                                              SceneMetaManager& manager )
+{
+    const auto& tonemapping = AccessParams< RgDrawFrameTonemappingParams >( drawInfo );
+    const auto& bloom = AccessParams< RgDrawFrameBloomParams >( drawInfo );
+    const auto asArray = []( const RgFloat3D& value ) {
+        return std::array{ value.data[ 0 ], value.data[ 1 ], value.data[ 2 ] };
+    };
+    auto reloadEditorValue = [ & ] {
+        manager.ClearLiveOverrides();
+        manager.OnFileChanged( FileType::JSON, manager.GetPath() );
+        sceneEdit = manager.Access( currentMap ).value_or( SceneMeta{} );
+        sceneEdit.sceneName = currentMap;
+        manager.SetLiveOverride( currentMap, sceneEdit );
+    };
+    if( scenesDocument )
+    {
+        std::string error;
+        ImGui::BeginDisabled( !scenesDocument->CanUndo() );
+        if( ImGui::Button( "Undo tone mapping" ) )
+        {
+            if( scenesDocument->Undo( ValidateScenes, error ) )
+            {
+                reloadEditorValue();
+                statusMessage = "Undid scene settings action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !scenesDocument->CanRedo() );
+        if( ImGui::Button( "Redo tone mapping" ) )
+        {
+            if( scenesDocument->Redo( ValidateScenes, error ) )
+            {
+                reloadEditorValue();
+                statusMessage = "Redid scene settings action and saved";
+            }
+            else if( !error.empty() ) statusMessage = error;
+        }
+        ImGui::EndDisabled();
+    }
+
+    auto optionalBool = [ & ]( const char* label,
+                               const char* field,
+                               std::optional< bool >& value,
+                               bool defaultValue,
+                               const char* tooltip ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional< bool >( defaultValue ) : std::nullopt;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            const std::string json = value ? ( *value ? "true" : "false" ) : "";
+            SaveSceneField( field,
+                            value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        bool edit = value.value_or( defaultValue );
+        if( ImGui::Checkbox( label, &edit ) )
+        {
+            value = edit;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            SaveSceneField( field, edit ? "true" : "false" );
+        }
+        if( ImGui::IsItemHovered( ImGuiHoveredFlags_AllowWhenDisabled ) )
+            ImGui::SetTooltip( "%s", tooltip );
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+    auto optionalFloat = [ & ]( const char* label,
+                                const char* field,
+                                std::optional< float >& value,
+                                float defaultValue,
+                                float minimum,
+                                float maximum,
+                                const char* tooltip ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional< float >( std::clamp( defaultValue,
+                                                               minimum,
+                                                               maximum ) )
+                         : std::nullopt;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            const std::string json = value ? JsonFloat( *value ) : std::string{};
+            SaveSceneField( field,
+                            value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        float edit = value.value_or( defaultValue );
+        if( ImGui::DragFloat( label,
+                              &edit,
+                              std::max( ( maximum - minimum ) / 500.0f, 0.001f ),
+                              minimum,
+                              maximum ) )
+        {
+            if( ImGui::IsItemActivated() && scenesDocument ) scenesDocument->BeginAction();
+            value = std::clamp( edit, minimum, maximum );
+            manager.SetLiveOverride( currentMap, sceneEdit );
+        }
+        if( ImGui::IsItemHovered( ImGuiHoveredFlags_AllowWhenDisabled ) )
+            ImGui::SetTooltip( "%s", tooltip );
+        if( ImGui::IsItemDeactivatedAfterEdit() && value )
+        {
+            const std::string json = JsonFloat( *value );
+            SaveSceneField( field, json );
+        }
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+    auto optionalVector = [ & ]( const char* label,
+                                 const char* field,
+                                 std::optional< std::array< float, 3 > >& value,
+                                 std::array< float, 3 > defaultValue,
+                                 float minimum,
+                                 float maximum,
+                                 bool normalizeCrosstalk,
+                                 const char* tooltip ) {
+        bool used = value.has_value();
+        ImGui::PushID( field );
+        if( ImGui::Checkbox( "Used", &used ) )
+        {
+            value = used ? std::optional( defaultValue ) : std::nullopt;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+            const std::string json = value ? JsonArray( *value ) : std::string{};
+            SaveSceneField( field,
+                            value ? std::optional< std::string_view >( json ) : std::nullopt );
+        }
+        ImGui::SameLine();
+        ImGui::BeginDisabled( !used );
+        auto edit = value.value_or( defaultValue );
+        if( ImGui::DragFloat3( label, edit.data(), 0.01f, minimum, maximum ) )
+        {
+            if( ImGui::IsItemActivated() && scenesDocument ) scenesDocument->BeginAction();
+            for( float& channel : edit ) channel = std::clamp( channel, minimum, maximum );
+            if( normalizeCrosstalk )
+                edit = live_editor_logic::NormalizeCrosstalk( edit );
+            value = edit;
+            manager.SetLiveOverride( currentMap, sceneEdit );
+        }
+        if( ImGui::IsItemHovered( ImGuiHoveredFlags_AllowWhenDisabled ) )
+            ImGui::SetTooltip( "%s", tooltip );
+        if( ImGui::IsItemDeactivatedAfterEdit() && value )
+        {
+            const std::string json = JsonArray( *value );
+            SaveSceneField( field, json );
+        }
+        ImGui::EndDisabled();
+        ImGui::PopID();
+    };
+
+    ImGui::TextWrapped( "Unused values inherit the current renderer cvars. Changes preview live and save when an interaction ends." );
+
+    if( ImGui::CollapsingHeader( "Exposure", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        optionalBool(
+            "Freeze eye adaptation",
+            "tonemapDisableEyeAdaptation",
+            sceneEdit.tonemapDisableEyeAdaptation,
+            tonemapping.disableEyeAdaptation != 0,
+            "Stops updating the measured scene luminance at its current value. This is not a manual exposure control." );
+        optionalFloat( "Minimum EV100",
+                       "tonemapEv100Min",
+                       sceneEdit.tonemapEv100Min,
+                       tonemapping.ev100Min,
+                       -3.0f,
+                       tonemapping.ev100Max,
+                       "Brightest exposure the adaptation range may select. Lower EV100 produces a brighter image." );
+        optionalFloat( "Maximum EV100",
+                       "tonemapEv100Max",
+                       sceneEdit.tonemapEv100Max,
+                       tonemapping.ev100Max,
+                       tonemapping.ev100Min,
+                       16.0f,
+                       "Darkest exposure the adaptation range may select. Higher EV100 produces a darker image." );
+        optionalFloat( "White point",
+                       "tonemapWhitePoint",
+                       sceneEdit.tonemapWhitePoint,
+                       tonemapping.luminanceWhitePoint,
+                       0.01f,
+                       1000.0f,
+                       "Luminance mapped to display white. Larger values preserve more highlight detail." );
+    }
+
+    if( ImGui::CollapsingHeader( "Color mapping", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        optionalVector( "RGB saturation adjustment",
+                        "tonemapSaturation",
+                        sceneEdit.tonemapSaturation,
+                        asArray( tonemapping.saturation ),
+                        -1.0f,
+                        1.0f,
+                        false,
+                        "Per-channel saturation adjustment: -1 removes that channel's saturation, 0 is neutral, and positive values increase it." );
+        optionalVector( "RGB highlight crosstalk",
+                        "tonemapCrosstalk",
+                        sceneEdit.tonemapCrosstalk,
+                        asArray( tonemapping.crosstalk ),
+                        0.001f,
+                        1.0f,
+                        true,
+                        "Controls how saturated highlights roll toward white. The strongest channel is normalized to 1; lower companion channels preserve more colored highlights." );
+    }
+
+    if( ImGui::CollapsingHeader( "Bloom", ImGuiTreeNodeFlags_DefaultOpen ) )
+    {
+        ImGui::TextWrapped( "Bloom intensity 0 disables the bloom pass for this map." );
+        optionalFloat( "Intensity",
+                       "bloomIntensity",
+                       sceneEdit.bloomIntensity,
+                       bloom.bloomIntensity,
+                       0.0f,
+                       10.0f,
+                       "Overall strength of the blurred highlight contribution." );
+        optionalFloat( "Input threshold",
+                       "bloomInputThreshold",
+                       sceneEdit.bloomInputThreshold,
+                       bloom.inputThreshold,
+                       0.0f,
+                       100.0f,
+                       "Minimum scene brightness that contributes to bloom." );
+        optionalFloat( "Emission multiplier",
+                       "bloomEmissionMultiplier",
+                       sceneEdit.bloomEmissionMultiplier,
+                       bloom.bloomEmissionMultiplier,
+                       0.0f,
+                       1000.0f,
+                       "Extra bloom weight applied to emissive materials." );
+        optionalFloat( "Lens dirt intensity",
+                       "bloomLensDirtIntensity",
+                       sceneEdit.bloomLensDirtIntensity,
+                       bloom.lensDirtIntensity,
+                       0.0f,
+                       10.0f,
+                       "Strength of the lens-dirt texture modulation. Set to 0 to disable it." );
+    }
+}
