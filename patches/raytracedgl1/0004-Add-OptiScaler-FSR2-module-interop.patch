From fbdf19dd90702a31442c7db6add68650d5f5e5a9 Mon Sep 17 00:00:00 2001
From: John Doe <johndoe@example.com>
Date: Wed, 22 Jul 2026 18:26:19 +0200
Subject: [PATCH] Add OptiScaler FSR2 module interop

---
 Source/FSR2.cpp              | 49 ++++++++++++++++++++++++++++++++++++
 Source/JsonParser.cpp        |  1 +
 Source/JsonParser.h          |  1 +
 Source/VulkanDevice_Init.cpp | 19 ++++++++------
 4 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/Source/FSR2.cpp b/Source/FSR2.cpp
index 2991018..dedefc6 100644
--- a/Source/FSR2.cpp
+++ b/Source/FSR2.cpp
@@ -28,8 +28,50 @@
 #include "RenderResolutionHelper.h"
 #include "RgException.h"
 
+#if defined( _WIN32 )
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+#endif
+
 namespace
 {
+#if defined( _WIN32 )
+void TryOptiScalerModuleHook()
+{
+    HMODULE proxy = GetModuleHandleW( L"dbghelp.dll" );
+    if( proxy == nullptr )
+    {
+        return;
+    }
+
+    using HookFn = BOOL( WINAPI* )( HMODULE );
+    auto hook = reinterpret_cast< HookFn >(
+        GetProcAddress( proxy, "OptiScalerHookFSR2VkModule" ) );
+    if( hook == nullptr )
+    {
+        return;
+    }
+
+    HMODULE renderer = nullptr;
+    if( !GetModuleHandleExW(
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast< LPCWSTR >( &TryOptiScalerModuleHook ),
+            &renderer ) ||
+        renderer == nullptr )
+    {
+        RTGL1::debug::Warning(
+            "FSR2: OptiScaler hook export found, but renderer module lookup failed" );
+        return;
+    }
+
+    if( !hook( renderer ) )
+    {
+        RTGL1::debug::Warning( "FSR2: OptiScaler rejected the renderer FSR2 hook request" );
+    }
+}
+#endif
+
 void CheckError( FfxErrorCode r )
 {
     if( r != FFX_OK )
@@ -45,6 +87,13 @@ RTGL1::FSR2::FSR2( VkDevice _device, VkPhysicalDevice _physDevice )
     , physDevice( _physDevice )
     , context( std::make_unique< std::optional< FfxFsr2Context > >() )
 {
+#if defined( _WIN32 )
+    static const bool optiScalerHookRequested = []() {
+        TryOptiScalerModuleHook();
+        return true;
+    }();
+    (void)optiScalerHookRequested;
+#endif
 }
 
 RTGL1::FSR2::~FSR2()
diff --git a/Source/JsonParser.cpp b/Source/JsonParser.cpp
index 4bc83ba..9edf04b 100644
--- a/Source/JsonParser.cpp
+++ b/Source/JsonParser.cpp
@@ -299,6 +299,7 @@ auto RTGL1::json_parser::detail::ReadSceneMetaArray( const std::filesystem::path
 // clang-format off
 JSON_TYPE( RTGL1::LibraryConfig )
       "developerMode", &T::developerMode
+    , "developerWindow", &T::developerWindow
     , "vulkanValidation", &T::vulkanValidation
     , "dlssValidation", &T::dlssValidation
     , "fpsMonitor", &T::fpsMonitor
diff --git a/Source/JsonParser.h b/Source/JsonParser.h
index 77202d6..a4e910d 100644
--- a/Source/JsonParser.h
+++ b/Source/JsonParser.h
@@ -37,6 +37,7 @@ struct LibraryConfig
     constexpr static int RequiredVersion{ 0 };
 
     bool developerMode    = false;
+    bool developerWindow  = true;
     bool vulkanValidation = false;
     bool dlssValidation   = false;
     bool fpsMonitor       = false;
diff --git a/Source/VulkanDevice_Init.cpp b/Source/VulkanDevice_Init.cpp
index f2bc65e..af20c0c 100644
--- a/Source/VulkanDevice_Init.cpp
+++ b/Source/VulkanDevice_Init.cpp
@@ -243,14 +243,17 @@ RTGL1::VulkanDevice::VulkanDevice( const RgInstanceCreateInfo* info )
     
     if( libconfig.developerMode )
     {
-        debugWindows = std::make_shared< DebugWindows >( 
-            instance,
-            physDevice->Get(),
-            device,
-            queues->GetIndexGraphics(),
-            queues->GetGraphics(),
-            cmdManager );
-        debugWindows->Init( debugWindows );
+        if( libconfig.developerWindow )
+        {
+            debugWindows = std::make_shared< DebugWindows >(
+                instance,
+                physDevice->Get(),
+                device,
+                queues->GetIndexGraphics(),
+                queues->GetGraphics(),
+                cmdManager );
+            debugWindows->Init( debugWindows );
+        }
 
         devmode = std::make_unique<Devmode>();
 
