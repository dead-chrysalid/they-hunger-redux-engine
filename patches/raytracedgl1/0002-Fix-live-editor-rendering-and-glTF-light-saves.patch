+bool RTGL1::LiveEditorDocument::SetRootNestedObjectField(
+    std::string_view                 objectField,
+    std::string_view                 nestedObjectField,
+    std::string_view                 field,
+    std::optional< std::string_view > jsonValue,
+    std::string&                     error )
+{
+    auto root = RootObject( text );
+    if( !root )
+    {
+        error = "The document has no valid root object";
+        return false;
+    }
+    auto outerProperty = Property( text, root->first, root->second, objectField );
+    if( !outerProperty )
+    {
+        if( !jsonValue ) return true;
+        if( !SetObjectProperty( text, *root, objectField, "{}", error ) ) return false;
+        root = RootObject( text );
+        outerProperty = root ? Property( text, root->first, root->second, objectField )
+                             : std::nullopt;
+    }
+    auto outerValue = outerProperty ? PropertyValue( text, *outerProperty ) : std::nullopt;
+    auto outerClose = outerValue ? Matching( text, outerValue->first ) : std::nullopt;
+    if( !outerValue || !outerClose || text[ outerValue->first ] != '{' )
+    {
+        error = "Root property is not an object: " + std::string( objectField );
+        return false;
+    }
+    Range outer{ outerValue->first, *outerClose };
+    auto nestedProperty = Property( text, outer.first, outer.second, nestedObjectField );
+    if( !nestedProperty )
+    {
+        if( !jsonValue ) return true;
+        if( !SetObjectProperty( text, outer, nestedObjectField, "{}", error ) ) return false;
+        root = RootObject( text );
+        outerProperty = root ? Property( text, root->first, root->second, objectField )
+                             : std::nullopt;
+        outerValue = outerProperty ? PropertyValue( text, *outerProperty ) : std::nullopt;
+        outerClose = outerValue ? Matching( text, outerValue->first ) : std::nullopt;
+        if( !outerValue || !outerClose ) return false;
+        outer = { outerValue->first, *outerClose };
+        nestedProperty = Property( text, outer.first, outer.second, nestedObjectField );
+    }
+    auto nestedValue = nestedProperty ? PropertyValue( text, *nestedProperty ) : std::nullopt;
+    auto nestedClose = nestedValue ? Matching( text, nestedValue->first ) : std::nullopt;
+    if( !nestedValue || !nestedClose || text[ nestedValue->first ] != '{' )
+    {
+        error = "Nested property is not an object: " + std::string( nestedObjectField );
+        return false;
+    }
+    return SetObjectProperty(
+        text, Range{ nestedValue->first, *nestedClose }, field, jsonValue, error );
+}
+
+bool RTGL1::LiveEditorDocument::SetRootArrayElement( std::string_view arrayField,
+                                                     size_t index,
+                                                     std::string_view jsonValue,
+                                                     std::string& error )
+{
+    const auto root = RootObject( text );
+    const auto array = root ? RootArray( text, *root, arrayField ) : std::nullopt;
+    const auto element = array ? ArrayElement( text, *array, index ) : std::nullopt;
+    if( !element )
+    {
+        error = "Missing JSON array element " + std::to_string( index ) + " in " +
+                std::string( arrayField );
+        return false;
+    }
+    text.replace( element->first, element->second - element->first, jsonValue );
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::SetRootArrayObjectField(
+    std::string_view                 arrayField,
+    size_t                           index,
+    std::string_view                 field,
+    std::optional< std::string_view > jsonValue,
+    std::string&                     error )
+{
+    const auto root = RootObject( text );
+    const auto array = root ? RootArray( text, *root, arrayField ) : std::nullopt;
+    const auto element = array ? ArrayElement( text, *array, index ) : std::nullopt;
+    if( !element || element->first >= text.size() || text[ element->first ] != '{' )
+    {
+        error = "JSON array element is not an object: " + std::string( arrayField ) + "[" +
+                std::to_string( index ) + "]";
+        return false;
+    }
+    return SetObjectProperty(
+        text, Range{ element->first, element->second - 1 }, field, jsonValue, error );
+}
+
+bool RTGL1::LiveEditorDocument::AppendRootArrayElement( std::string_view arrayField,
+                                                        std::string_view jsonValue,
+                                                        std::string& error )
+{
+    const auto root = RootObject( text );
+    const auto array = root ? RootArray( text, *root, arrayField ) : std::nullopt;
+    if( !array )
+    {
+        error = "Missing JSON array property: " + std::string( arrayField );
+        return false;
+    }
+    const bool empty = SkipTrivia( text, array->first + 1 ) >= array->second;
+    const std::string indent = IndentAt( text, array->first ) + "    ";
+    text.insert( array->second,
+                 ( empty ? "\n" : ",\n" ) + indent + std::string( jsonValue ) );
+    return true;
+}
+
+bool RTGL1::LiveEditorDocument::EnsureRootStringArrayContains( std::string_view arrayField,
+                                                               std::string_view value,
