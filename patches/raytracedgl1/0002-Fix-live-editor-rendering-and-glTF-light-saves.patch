+struct UiClipVertex
+{
+    ImVec2 position;
+    ImVec2 uv;
+    ImU32  color;
+};
+
+ImU32 LerpUiColor( ImU32 a, ImU32 b, float t )
+{
+    auto channel = [ t ]( ImU32 lhs, ImU32 rhs, int shift ) {
+        const float x = static_cast< float >( ( lhs >> shift ) & 0xFF );
+        const float y = static_cast< float >( ( rhs >> shift ) & 0xFF );
+        return static_cast< ImU32 >( std::clamp( std::lround( x + ( y - x ) * t ),
+                                                0L,
+                                                255L ) );
+    };
+    return channel( a, b, IM_COL32_R_SHIFT ) << IM_COL32_R_SHIFT |
+           channel( a, b, IM_COL32_G_SHIFT ) << IM_COL32_G_SHIFT |
+           channel( a, b, IM_COL32_B_SHIFT ) << IM_COL32_B_SHIFT |
+           channel( a, b, IM_COL32_A_SHIFT ) << IM_COL32_A_SHIFT;
+}
+
+UiClipVertex LerpUiVertex( const UiClipVertex& a, const UiClipVertex& b, float t )
+{
+    return {
+        .position = { a.position.x + ( b.position.x - a.position.x ) * t,
+                      a.position.y + ( b.position.y - a.position.y ) * t },
+        .uv = { a.uv.x + ( b.uv.x - a.uv.x ) * t,
+                a.uv.y + ( b.uv.y - a.uv.y ) * t },
+        .color = LerpUiColor( a.color, b.color, t ),
+    };
+}
+
+size_t ClipUiTriangle( const std::array< UiClipVertex, 3 >& triangle,
+                       const ImVec4& clip,
+                       std::array< UiClipVertex, 12 >& result )
+{
+    std::array< UiClipVertex, 12 > polygon{};
+    std::copy( triangle.begin(), triangle.end(), polygon.begin() );
+    size_t polygonCount = triangle.size();
+    for( int edge = 0; edge < 4 && polygonCount > 0; edge++ )
+    {
+        auto distance = [ edge, &clip ]( const UiClipVertex& v ) {
+            switch( edge )
+            {
+                case 0: return v.position.x - clip.x;
+                case 1: return clip.z - v.position.x;
+                case 2: return v.position.y - clip.y;
+                default: return clip.w - v.position.y;
+            }
+        };
+        std::array< UiClipVertex, 12 > clipped{};
+        size_t clippedCount = 0;
+        UiClipVertex previous = polygon[ polygonCount - 1 ];
+        float previousDistance = distance( previous );
+        for( size_t i = 0; i < polygonCount; i++ )
+        {
+            const UiClipVertex& current = polygon[ i ];
+            const float currentDistance = distance( current );
+            const bool previousInside = previousDistance >= 0.0f;
+            const bool currentInside  = currentDistance >= 0.0f;
+            if( previousInside != currentInside )
+            {
+                const float denominator = previousDistance - currentDistance;
+                const float t = std::abs( denominator ) > 0.000001f
+                                    ? previousDistance / denominator
+                                    : 0.0f;
+                clipped[ clippedCount++ ] = LerpUiVertex( previous, current, t );
+            }
+            if( currentInside ) clipped[ clippedCount++ ] = current;
+            previous = current;
+            previousDistance = currentDistance;
+        }
+        polygon = clipped;
+        polygonCount = clippedCount;
+    }
+    std::copy_n( polygon.begin(), polygonCount, result.begin() );
+    return polygonCount;
+}
+
+RgPrimitiveVertex MakeUiPrimitiveVertex( const UiClipVertex& source )
+{
+    RgPrimitiveVertex result{};
+    result.position[ 0 ] = source.position.x;
+    result.position[ 1 ] = source.position.y;
+    result.normal[ 2 ]   = 1.0f;
+    result.texCoord[ 0 ] = source.uv.x;
+    result.texCoord[ 1 ] = source.uv.y;
+    result.color         = source.color;
+    return result;
+}
