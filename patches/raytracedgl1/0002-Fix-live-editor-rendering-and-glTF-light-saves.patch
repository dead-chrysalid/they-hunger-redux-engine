+std::optional< Range > ArrayElement( std::string_view s, const Range& array, size_t index )
+{
+    size_t current = 0;
+    for( size_t i = array.first + 1; i < array.second; )
+    {
+        i = SkipTrivia( s, i );
+        if( i >= array.second ) break;
+        if( s[ i ] == ',' )
+        {
+            i++;
+            continue;
+        }
+
+        const size_t begin = i;
+        size_t end = i;
+        if( s[ i ] == '{' || s[ i ] == '[' )
+        {
+            const auto close = Matching( s, i );
+            if( !close || *close > array.second ) return std::nullopt;
+            end = *close + 1;
+        }
+        else if( s[ i ] == '"' || s[ i ] == '\'' )
+        {
+            end = SkipString( s, i );
+        }
+        else
+        {
+            while( end < array.second && s[ end ] != ',' ) end++;
+            while( end > begin &&
+                   std::isspace( static_cast< unsigned char >( s[ end - 1 ] ) ) )
+            {
+                end--;
+            }
+        }
+        if( current++ == index ) return Range{ begin, end };
+        i = end;
+    }
+    return std::nullopt;
+}
+
+std::optional< Range > RootArray( std::string_view s,
+                                  const Range& root,
+                                  std::string_view field )
+{
+    const auto property = Property( s, root.first, root.second, field );
+    const auto value = property ? PropertyValue( s, *property ) : std::nullopt;
+    if( !value || value->first >= s.size() || s[ value->first ] != '[' )
+    {
+        return std::nullopt;
+    }
+    const auto close = Matching( s, value->first );
+    return close ? std::optional< Range >( Range{ value->first, *close } ) : std::nullopt;
+}
