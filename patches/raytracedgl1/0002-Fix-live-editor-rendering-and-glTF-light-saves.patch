+std::string RTGL1::LiveEditor::SerializePunctualLightNode( const EditableLight& editable,
+                                                           size_t lightIndex )
+{
+    const RgFloat3D position = LightPosition( editable.value, editable.nodePosition );
+    std::string json = "{\n";
+    json += "            \"extensions\": { \"KHR_lights_punctual\": { \"light\": " +
+            std::to_string( lightIndex ) + " } },\n";
+    json += "            \"name\": " + LiveEditorDocument::Quote( editable.name ) + ",\n";
+    if( std::holds_alternative< RgSphericalLightUploadInfo >( editable.value ) )
+    {
+        json += "            \"translation\": " +
+                JsonArray( std::array{ position.data[ 0 ], position.data[ 1 ], position.data[ 2 ] } ) +
+                ",\n";
+    }
+    else
+    {
+        const RgFloat3D direction = LightDirection( editable.value );
+        const RgTransform transform = Utils::MakeTransform(
+            position,
+            { -direction.data[ 0 ], -direction.data[ 1 ], -direction.data[ 2 ] } );
+        const float matrix[ 16 ] = RG_TRANSFORM_TO_GLTF_MATRIX( transform );
+        std::array< float, 16 > matrixArray{};
+        std::copy( std::begin( matrix ), std::end( matrix ), matrixArray.begin() );
+        json += "            \"matrix\": " + JsonArray( matrixArray ) + ",\n";
+    }
+    json += "            \"extras\": { \"rt_editor_id\": " +
+            LiveEditorDocument::Quote( editable.id ) + " }\n";
+    return json + "        }";
+}
