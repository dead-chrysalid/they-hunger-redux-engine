+void RTGL1::LiveEditor::ReadGltfLayout()
+{
+    gltfMainNodeIndex = SIZE_MAX;
+    gltfNodeCount = 0;
+    gltfLightNodeSlots.clear();
+    gltfMainNonLightChildren.clear();
+    gltfHasEditorPunctualMirror = false;
+    if( !gltfDocument ) return;
+
+    cgltf_options options{};
+    cgltf_data* data{};
+    if( cgltf_parse_file( &options, gltfDocument->Path().string().c_str(), &data ) !=
+            cgltf_result_success ||
+        !data )
+    {
+        if( data ) cgltf_free( data );
+        return;
+    }
+    gltfNodeCount = data->nodes_count;
+    for( size_t i = 0; i < data->nodes_count; i++ )
+    {
+        if( data->nodes[ i ].light )
+        {
+            gltfLightNodeSlots.push_back( i );
+            const char* nodeExtras = data->nodes[ i ].extras.data;
+            const char* lightExtras = data->nodes[ i ].light->extras.data;
+            gltfHasEditorPunctualMirror |=
+                ( nodeExtras && std::strstr( nodeExtras, "rt_editor_id" ) ) ||
+                ( lightExtras && std::strstr( lightExtras, "rt_editor_id" ) );
+        }
+    }
+
+    cgltf_scene* activeScene = data->scene;
+    if( !activeScene && data->scenes_count > 0 ) activeScene = &data->scenes[ 0 ];
+    if( activeScene && activeScene->nodes_count == 1 && activeScene->nodes[ 0 ] )
+    {
+        cgltf_node* mainNode = activeScene->nodes[ 0 ];
+        gltfMainNodeIndex = static_cast< size_t >( mainNode - data->nodes );
+        for( size_t i = 0; i < mainNode->children_count; i++ )
+        {
+            cgltf_node* child = mainNode->children[ i ];
+            if( child && !child->light )
+            {
+                gltfMainNonLightChildren.push_back(
+                    static_cast< size_t >( child - data->nodes ) );
+            }
+        }
+    }
+    cgltf_free( data );
+}
