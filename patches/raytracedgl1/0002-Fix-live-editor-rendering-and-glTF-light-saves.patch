+void RTGL1::LiveEditor::RefreshUnsavedStatus()
+{
+    const auto pending = []( const std::unique_ptr< LiveEditorDocument >& document ) {
+        return document && ( document->IsDirty() || document->IsInAction() );
+    };
+    hasUnsavedChanges = lightAction || pending( scenesDocument ) ||
+                        pending( globalTexturesDocument ) ||
+                        pending( sceneTexturesDocument ) || pending( gltfDocument );
+}
