+            std::holds_alternative< RgDirectionalLightUploadInfo >( editable.value );
+        const bool spot = std::holds_alternative< RgSpotLightUploadInfo >( editable.value );
+        const float intensity = directional
+                                    ? LightIntensity( editable.value )
+                                    : LightIntensity( editable.value ) /
+                                          ( 4.0f * float( Utils::M_PI ) );
+        float sourceRadius = 0.05f;
+        float angularDiameter = 0.5f;
+        float inner = 0.0f;
+        float outer = 0.7853982f;
+        if( const auto* point = std::get_if< RgSphericalLightUploadInfo >( &editable.value ) )
+            sourceRadius = point->radius;
+        if( const auto* spotValue = std::get_if< RgSpotLightUploadInfo >( &editable.value ) )
+        {
+            sourceRadius = spotValue->radius;
+            inner = spotValue->angleInner;
+            outer = spotValue->angleOuter;
+        }
+        if( const auto* sun = std::get_if< RgDirectionalLightUploadInfo >( &editable.value ) )
+            angularDiameter = sun->angularDiameterDegrees;
+        const auto& extra = std::visit(
+            []( const auto& v ) -> const RgLightExtraInfo& { return v.extra; }, editable.value );
+
+        json += "        {\n";
+        json += "            \"name\": " + LiveEditorDocument::Quote( editable.name ) + ",\n";
+        json += "            \"color\": [" + JsonFloat( color[ 0 ] / 255.0f ) + ", " +
+                JsonFloat( color[ 1 ] / 255.0f ) + ", " +
+                JsonFloat( color[ 2 ] / 255.0f ) + "],\n";
+        json += "            \"intensity\": " + JsonFloat( std::max( intensity, 0.0f ) ) +
+                ",\n";
+        json += "            \"type\": " +
+                LiveEditorDocument::Quote( LightType( editable.value ) );
+        if( spot )
+        {
+            json += ",\n            \"spot\": { \"innerConeAngle\": " + JsonFloat( inner ) +
+                    ", \"outerConeAngle\": " + JsonFloat( outer ) + " }";
+        }
+        json += ",\n            \"extras\": {\n";
+        json += "                \"rt_editor_id\": " +
+                LiveEditorDocument::Quote( editable.id ) + ",\n";
+        json += "                \"rt_source_radius\": " + JsonFloat( sourceRadius ) + ",\n";
+        json += "                \"rt_angular_diameter_degrees\": " +
+                JsonFloat( angularDiameter ) + ",\n";
+        json += "                \"lightstyle\": " +
+                std::to_string( std::clamp( extra.lightstyle, 0, 63 ) ) + ",\n";
+        json += std::string( "                \"isVolumetric\": " ) +
+                ( extra.isVolumetric ? "true" : "false" ) + "\n";
+        json += "            }\n        }";
+        if( i + 1 < values.size() ) json += ',';
+        json += '\n';
+    }
+    return json + "    ]";
+}
