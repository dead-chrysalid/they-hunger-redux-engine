+        if( !element ) break;
+        const std::string_view raw( text.data() + element->first,
+                                    element->second - element->first );
+        if( raw == Quote( value ) ) return true;
+    }
+    const bool empty = SkipTrivia( text, array->first + 1 ) >= array->second;
+    text.insert( array->second, ( empty ? "" : ", " ) + Quote( value ) );
+    return true;
+}
